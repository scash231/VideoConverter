<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VideoConverterUI.Controls">

    <!-- The grouped-form look of Settings (macOS System Settings): groups of rows with hairline separators,
         switches, push buttons. Merged into SettingsWindow, EditorWindow and BatchQueueWindow. -->

    <!-- ══════ Grouped form ══════ -->
    <Style x:Key="Group" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tint0D}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,22"/>
    </Style>
    <!-- A group sitting on Liquid Glass: a faint wash instead of the opaque card, so the glass shows through -->
    <Style x:Key="GlassGroup" TargetType="Border" BasedOn="{StaticResource Group}">
        <Setter Property="Background" Value="{DynamicResource Tint0A}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tint12}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="Header" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="2,0,0,8"/>
    </Style>
    <Style x:Key="Footer" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="Margin" Value="2,-14,8,22"/>
    </Style>
    <Style x:Key="Row" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Margin" Value="12,0"/>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="Background" Value="{DynamicResource Tint0F}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
    <Style x:Key="LabelStack" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,9,16,9"/>
    </Style>
    <Style x:Key="LabelInStack" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- glisse's switch (Controls/GlassSwitch) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="DockPanel.Dock" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <controls:GlassSwitch x:Name="Root" IsOn="{TemplateBinding IsChecked}" IsHeld="{TemplateBinding IsPressed}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Push button -->
    <Style x:Key="Push" TargetType="Button" BasedOn="{StaticResource GlassBtn}">
        <Setter Property="DockPanel.Dock" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>
    <Style x:Key="PushPrimary" TargetType="Button" BasedOn="{StaticResource Push}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnMedia}"/>
    </Style>

    <!-- Destructive push (Reset All…): glisse's destructive button, a red label on the glass -->
    <Style x:Key="PushDestructive" TargetType="Button" BasedOn="{StaticResource Push}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorRed}"/>
    </Style>

    <!-- Segmented control: a soft track (GlassSegmentTrack) holding RadioButtons; the chosen one is a raised chip -->
    <Style x:Key="GlassSegmentTrack" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tint0D}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="2"/>
    </Style>
    <Style x:Key="GlassSegment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="6,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint0D}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint26}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round button inside a glass circle or capsule (Settings close/back, editor playback, window controls) -->
    <Style x:Key="GlassRoundBtn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Bd" Fill="{DynamicResource Tint1F}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
