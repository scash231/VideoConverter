    <sys:String x:Key="ErrAdv_ferrite_missing_Title">Ferrite engine not found</sys:String>
    <sys:String x:Key="ErrAdv_ferrite_missing_Summary">The Ferrite backend (ferrite.exe) is missing next to VideoConverter, so jobs cannot start.</sys:String>
    <sys:String x:Key="ErrAdv_ferrite_missing_Fix1">Switch to the Native engine: Settings → Advanced → Execution Engine.</sys:String>
    <sys:String x:Key="ErrAdv_ferrite_missing_Fix2">Reinstall VideoConverter to restore ferrite.exe.</sys:String>
    <sys:String x:Key="ErrAdv_ferrite_missing_Fix3">Building from source: install Rust from rustup.rs and build the solution again – it compiles ferrite.exe automatically.</sys:String>
    <sys:String x:Key="ErrAdv_ferrite_crashed_Title">Ferrite engine stopped</sys:String>
    <sys:String x:Key="ErrAdv_ferrite_crashed_Summary">The Ferrite backend process ended unexpectedly. Running jobs were stopped.</sys:String>
    <sys:String x:Key="ErrAdv_ferrite_crashed_Fix1">Click 'Restart Backend' and start the job again.</sys:String>
    <sys:String x:Key="ErrAdv_ferrite_crashed_Fix2">If it keeps happening, switch to Native in Settings → Advanced and send the console log (Show Logs) to the developer.</sys:String>
    <sys:String x:Key="ErrAdv_python_missing_Title">Python not found</sys:String>
    <sys:String x:Key="ErrAdv_python_missing_Summary">The Legacy engine needs Python, but no Python installation was found.</sys:String>
    <sys:String x:Key="ErrAdv_python_missing_Fix1">Switch to Native or Ferrite in Settings → Advanced – they don't need Python.</sys:String>
    <sys:String x:Key="ErrAdv_python_missing_Fix2">Or install Python 3.12 from python.org, tick 'Add python.exe to PATH' and restart VideoConverter.</sys:String>
    <sys:String x:Key="ErrAdv_classic_server_missing_Title">Legacy backend files missing</sys:String>
    <sys:String x:Key="ErrAdv_classic_server_missing_Summary">The Python backend (backend\server.py) is not part of this installation.</sys:String>
    <sys:String x:Key="ErrAdv_classic_server_missing_Fix1">Switch to Native or Ferrite in Settings → Advanced.</sys:String>
    <sys:String x:Key="ErrAdv_classic_server_missing_Fix2">Legacy is no longer supported. If you still need it, download VideoConverter-Legacy-Python.zip from scash.uk/vc and follow its README.</sys:String>
    <sys:String x:Key="ErrAdv_backend_down_Title">Engine not responding</sys:String>
    <sys:String x:Key="ErrAdv_backend_down_Summary">The {engine} engine is not ready or cannot be reached.</sys:String>
    <sys:String x:Key="ErrAdv_backend_down_Fix1">Click 'Restart Backend' below.</sys:String>
    <sys:String x:Key="ErrAdv_backend_down_Fix2">Legacy engine: make sure nothing else uses port 8765 and the firewall allows local connections.</sys:String>
    <sys:String x:Key="ErrAdv_backend_down_Fix3">If it keeps failing, choose another engine in Settings → Advanced.</sys:String>
    <sys:String x:Key="ErrAdv_empty_url_Title">No link entered</sys:String>
    <sys:String x:Key="ErrAdv_empty_url_Summary">The URL field is empty.</sys:String>
    <sys:String x:Key="ErrAdv_empty_url_Fix1">Copy the video link from your browser's address bar and paste it into the URL field.</sys:String>
    <sys:String x:Key="ErrAdv_empty_url_Fix2">Supported: YouTube, YouTube Music, TikTok, Instagram, X/Twitter, Vimeo, SoundCloud and many more.</sys:String>
    <sys:String x:Key="ErrAdv_title_missing_Title">Title missing</sys:String>
    <sys:String x:Key="ErrAdv_title_missing_Summary">A YouTube upload needs a title.</sys:String>
    <sys:String x:Key="ErrAdv_title_missing_Fix1">Enter a title, or click 'Fetch' to use the original video's title.</sys:String>
    <sys:String x:Key="ErrAdv_save_path_missing_Title">No save folder</sys:String>
    <sys:String x:Key="ErrAdv_save_path_missing_Summary">There is no folder to save the download to.</sys:String>
    <sys:String x:Key="ErrAdv_save_path_missing_Fix1">Click the folder button next to the save path and choose a folder.</sys:String>
    <sys:String x:Key="ErrAdv_save_path_missing_Fix2">Or set a default folder in Settings → Download.</sys:String>
    <sys:String x:Key="ErrAdv_local_path_Title">This is a file, not a link</sys:String>
    <sys:String x:Key="ErrAdv_local_path_Summary">'{url}' is a path on your computer. VideoConverter downloads from websites.</sys:String>
    <sys:String x:Key="ErrAdv_local_path_Fix1">To edit a local video, open the Video Editor (✂) in the header.</sys:String>
    <sys:String x:Key="ErrAdv_local_path_Fix2">To download, paste a web link that starts with https://.</sys:String>
    <sys:String x:Key="ErrAdv_search_query_Title">Not a link</sys:String>
    <sys:String x:Key="ErrAdv_search_query_Summary">'{url}' looks like a search term, not a web address.</sys:String>
    <sys:String x:Key="ErrAdv_search_query_Fix1">Find the video in your browser, open it and copy the link from the address bar.</sys:String>
    <sys:String x:Key="ErrAdv_missing_protocol_Title">Incomplete link</sys:String>
    <sys:String x:Key="ErrAdv_missing_protocol_Summary">'{url}' is missing https:// at the beginning.</sys:String>
    <sys:String x:Key="ErrAdv_missing_protocol_Fix1">Copy the full link from the browser's address bar (it starts with https://).</sys:String>
    <sys:String x:Key="ErrAdv_unsupported_url_Title">Website not supported</sys:String>
    <sys:String x:Key="ErrAdv_unsupported_url_Summary">yt-dlp does not recognise this link or found no downloadable video on it.</sys:String>
    <sys:String x:Key="ErrAdv_unsupported_url_Fix1">Make sure the link opens a single video – not a profile, search or home page.</sys:String>
    <sys:String x:Key="ErrAdv_unsupported_url_Fix2">Update yt-dlp: delete %LOCALAPPDATA%\VideoConverter\bin\yt-dlp.exe (it is downloaded again) or run 'yt-dlp -U'.</sys:String>
    <sys:String x:Key="ErrAdv_unsupported_url_Fix3">Supported: YouTube, YouTube Music, TikTok, Instagram, X/Twitter, Vimeo, SoundCloud and many more.</sys:String>
    <sys:String x:Key="ErrAdv_no_meta_Title">Could not load video details</sys:String>
    <sys:String x:Key="ErrAdv_no_meta_Summary">No information could be read for this link.</sys:String>
    <sys:String x:Key="ErrAdv_no_meta_Fix1">Open the link in your browser and check that the video plays without signing in.</sys:String>
    <sys:String x:Key="ErrAdv_no_meta_Fix2">Check your internet connection and try again.</sys:String>
    <sys:String x:Key="ErrAdv_no_meta_Fix3">Update yt-dlp: delete %LOCALAPPDATA%\VideoConverter\bin\yt-dlp.exe (it is downloaded again) or run 'yt-dlp -U'.</sys:String>
    <sys:String x:Key="ErrAdv_bot_check_Title">YouTube wants a sign-in check</sys:String>
    <sys:String x:Key="ErrAdv_bot_check_Summary">YouTube blocked the download and asks you to confirm that you're not a bot.</sys:String>
    <sys:String x:Key="ErrAdv_bot_check_Fix1">Export your YouTube cookies while signed in, e.g. with the browser extension 'Get cookies.txt LOCALLY'.</sys:String>
    <sys:String x:Key="ErrAdv_bot_check_Fix2">Select the cookies.txt in Settings → Advanced → Backend → Cookies file.</sys:String>
    <sys:String x:Key="ErrAdv_bot_check_Fix3">Or wait a few minutes / switch networks (VPN off or on) and try again.</sys:String>
    <sys:String x:Key="ErrAdv_age_restricted_Title">Age-restricted video</sys:String>
    <sys:String x:Key="ErrAdv_age_restricted_Summary">This video can only be watched with a signed-in account that is old enough.</sys:String>
    <sys:String x:Key="ErrAdv_age_restricted_Fix1">Export cookies from a browser where you are signed in to YouTube (e.g. with 'Get cookies.txt LOCALLY').</sys:String>
    <sys:String x:Key="ErrAdv_age_restricted_Fix2">Select the file in Settings → Advanced → Backend → Cookies file and try again.</sys:String>
    <sys:String x:Key="ErrAdv_members_only_Title">Members-only content</sys:String>
    <sys:String x:Key="ErrAdv_members_only_Summary">This video is only available to paying channel members.</sys:String>
    <sys:String x:Key="ErrAdv_members_only_Fix1">Export cookies from a browser signed in with a member account.</sys:String>
    <sys:String x:Key="ErrAdv_members_only_Fix2">Select the file in Settings → Advanced → Backend → Cookies file.</sys:String>
    <sys:String x:Key="ErrAdv_login_required_Title">Sign-in required</sys:String>
    <sys:String x:Key="ErrAdv_login_required_Summary">The site only shows this content to signed-in users (common for Instagram and some TikTok videos).</sys:String>
    <sys:String x:Key="ErrAdv_login_required_Fix1">Export cookies from your browser while signed in (e.g. with 'Get cookies.txt LOCALLY').</sys:String>
    <sys:String x:Key="ErrAdv_login_required_Fix2">Select the cookies.txt in Settings → Advanced → Backend → Cookies file and try again.</sys:String>
    <sys:String x:Key="ErrAdv_geo_blocked_Title">Not available in your region</sys:String>
    <sys:String x:Key="ErrAdv_geo_blocked_Summary">The uploader blocked this video for your country.</sys:String>
    <sys:String x:Key="ErrAdv_geo_blocked_Fix1">Try again with a VPN set to a country where the video is available.</sys:String>
    <sys:String x:Key="ErrAdv_unavailable_Title">Video unavailable</sys:String>
    <sys:String x:Key="ErrAdv_unavailable_Summary">The video is private, deleted or blocked.</sys:String>
    <sys:String x:Key="ErrAdv_unavailable_Fix1">Open the link in your browser to check whether it still plays.</sys:String>
    <sys:String x:Key="ErrAdv_unavailable_Fix2">Private videos only download with cookies from an account that has access (Settings → Advanced → Backend → Cookies file).</sys:String>
    <sys:String x:Key="ErrAdv_live_Title">Live stream or premiere</sys:String>
    <sys:String x:Key="ErrAdv_live_Summary">The video is still live or has not premiered yet.</sys:String>
    <sys:String x:Key="ErrAdv_live_Fix1">Wait until the stream or premiere has ended, then download it.</sys:String>
    <sys:String x:Key="ErrAdv_rate_limited_Title">Too many requests</sys:String>
    <sys:String x:Key="ErrAdv_rate_limited_Summary">The site temporarily blocks downloads from your connection (HTTP 429).</sys:String>
    <sys:String x:Key="ErrAdv_rate_limited_Fix1">Wait 10–30 minutes before trying again.</sys:String>
    <sys:String x:Key="ErrAdv_rate_limited_Fix2">Use a cookies file (Settings → Advanced → Backend) or another network.</sys:String>
    <sys:String x:Key="ErrAdv_rate_limited_Fix3">In the Multi Downloader, lower the number of parallel downloads.</sys:String>
    <sys:String x:Key="ErrAdv_js_runtime_Title">JavaScript runtime missing</sys:String>
    <sys:String x:Key="ErrAdv_js_runtime_Summary">yt-dlp needs Deno to read some YouTube pages and could not find it.</sys:String>
    <sys:String x:Key="ErrAdv_js_runtime_Fix1">Install Deno: open PowerShell and run  irm https://deno.land/install.ps1 | iex</sys:String>
    <sys:String x:Key="ErrAdv_js_runtime_Fix2">Restart VideoConverter – Native and Ferrite find %USERPROFILE%\.deno\bin automatically.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_impersonate_Title">yt-dlp needs its impersonation helper</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_impersonate_Summary">This site (often TikTok) only answers real browsers. yt-dlp can imitate one, but the helper package curl_cffi is missing.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_impersonate_Fix1">Open a terminal and run:  pip install -U "yt-dlp[default,curl-cffi]"</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_impersonate_Fix2">Or use the standalone yt-dlp.exe (it includes the helper): put it in %LOCALAPPDATA%\VideoConverter\bin and remove the pip version from PATH.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_impersonate_Fix3">Then click 'Restart Backend' and try again.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_failed_Title">Download failed</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_failed_Summary">yt-dlp could not download this video. Usually yt-dlp is outdated or the website changed.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_failed_Fix1">Update yt-dlp: delete %LOCALAPPDATA%\VideoConverter\bin\yt-dlp.exe (VideoConverter fetches the newest one) or run 'yt-dlp -U' / 'pip install -U yt-dlp'.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_failed_Fix2">Check that the video plays in your browser.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_failed_Fix3">The complete error is below and in the console (Show Logs).</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_missing_Title">yt-dlp not found</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_missing_Summary">The downloader yt-dlp is missing or could not be started.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_missing_Fix1">Click 'Restart Backend' – Native and Ferrite download yt-dlp automatically when it is missing.</sys:String>
    <sys:String x:Key="ErrAdv_ytdlp_missing_Fix2">Or install it yourself: 'pip install -U yt-dlp', or download yt-dlp.exe from github.com/yt-dlp/yt-dlp/releases.</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_missing_Title">FFmpeg not found</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_missing_Summary">FFmpeg is needed to merge video and audio and to convert files.</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_missing_Fix1">Click 'Install FFmpeg' below (also in Settings → Advanced → FFmpeg).</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_missing_Fix2">Then start the job again.</sys:String>
    <sys:String x:Key="ErrAdv_gpu_failed_Title">GPU encoding failed</sys:String>
    <sys:String x:Key="ErrAdv_gpu_failed_Summary">The graphics card encoder (NVENC, QSV or AMF) did not work for this video.</sys:String>
    <sys:String x:Key="ErrAdv_gpu_failed_Fix1">Turn off GPU acceleration in Settings → Advanced.</sys:String>
    <sys:String x:Key="ErrAdv_gpu_failed_Fix2">Update your graphics driver.</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_failed_Title">Conversion failed</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_failed_Summary">FFmpeg could not process the downloaded file.</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_failed_Fix1">Try another quality (e.g. 1080p instead of Best) or the fingerprint method 'Metadata'.</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_failed_Fix2">Reinstall FFmpeg in Settings → Advanced → FFmpeg.</sys:String>
    <sys:String x:Key="ErrAdv_ffmpeg_failed_Fix3">The console (Show Logs) contains FFmpeg's exact message.</sys:String>
    <sys:String x:Key="ErrAdv_subtitles_whisper_Title">Subtitle engine missing</sys:String>
    <sys:String x:Key="ErrAdv_subtitles_whisper_Summary">Subtitles need the Python package faster-whisper, which is not installed.</sys:String>
    <sys:String x:Key="ErrAdv_subtitles_whisper_Fix1">Open a terminal and run:  pip install faster-whisper</sys:String>
    <sys:String x:Key="ErrAdv_subtitles_whisper_Fix2">Subtitles also need the backend folder of a source checkout.</sys:String>
    <sys:String x:Key="ErrAdv_subtitles_failed_Title">Subtitles failed</sys:String>
    <sys:String x:Key="ErrAdv_subtitles_failed_Summary">The subtitle generator stopped with an error.</sys:String>
    <sys:String x:Key="ErrAdv_subtitles_failed_Fix1">Make sure Python with faster-whisper is installed:  pip install faster-whisper</sys:String>
    <sys:String x:Key="ErrAdv_subtitles_failed_Fix2">The complete error is below and in the console (Show Logs).</sys:String>
    <sys:String x:Key="ErrAdv_disk_full_Title">Disk full</sys:String>
    <sys:String x:Key="ErrAdv_disk_full_Summary">There is not enough free space on the drive.</sys:String>
    <sys:String x:Key="ErrAdv_disk_full_Fix1">Free up space or choose a folder on another drive.</sys:String>
    <sys:String x:Key="ErrAdv_disk_full_Fix2">Long or high-quality videos need several GB while they are merged.</sys:String>
    <sys:String x:Key="ErrAdv_file_in_use_Title">File is in use</sys:String>
    <sys:String x:Key="ErrAdv_file_in_use_Summary">Another program has the file open, so it cannot be written or moved.</sys:String>
    <sys:String x:Key="ErrAdv_file_in_use_Fix1">Close media players, editors or the Explorer preview that might show the file.</sys:String>
    <sys:String x:Key="ErrAdv_file_in_use_Fix2">Try again – antivirus scans sometimes lock new files for a few seconds.</sys:String>
    <sys:String x:Key="ErrAdv_access_denied_Title">Access denied</sys:String>
    <sys:String x:Key="ErrAdv_access_denied_Summary">VideoConverter is not allowed to write to this folder.</sys:String>
    <sys:String x:Key="ErrAdv_access_denied_Fix1">Choose a folder in your user profile, e.g. Downloads or Videos.</sys:String>
    <sys:String x:Key="ErrAdv_access_denied_Fix2">Windows Security → Ransomware protection → Controlled folder access may block the app: allow VideoConverter there.</sys:String>
    <sys:String x:Key="ErrAdv_path_not_found_Title">Folder not found</sys:String>
    <sys:String x:Key="ErrAdv_path_not_found_Summary">The save folder or file path does not exist (anymore).</sys:String>
    <sys:String x:Key="ErrAdv_path_not_found_Fix1">Choose the save folder again with the folder button.</sys:String>
    <sys:String x:Key="ErrAdv_path_not_found_Fix2">If it is on a USB or network drive, make sure it is connected.</sys:String>
    <sys:String x:Key="ErrAdv_download_missing_Title">Downloaded file not found</sys:String>
    <sys:String x:Key="ErrAdv_download_missing_Summary">yt-dlp finished, but the downloaded file could not be found.</sys:String>
    <sys:String x:Key="ErrAdv_download_missing_Fix1">Check that your antivirus did not quarantine the file.</sys:String>
    <sys:String x:Key="ErrAdv_download_missing_Fix2">Try another quality or format and download again.</sys:String>
    <sys:String x:Key="ErrAdv_cookies_invalid_Title">Cookies file problem</sys:String>
    <sys:String x:Key="ErrAdv_cookies_invalid_Summary">The cookies file could not be used.</sys:String>
    <sys:String x:Key="ErrAdv_cookies_invalid_Fix1">Export a fresh cookies.txt in Netscape format (e.g. with 'Get cookies.txt LOCALLY').</sys:String>
    <sys:String x:Key="ErrAdv_cookies_invalid_Fix2">Select it again in Settings → Advanced → Backend → Cookies file.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_classic_Title">Cloud upload not available in Legacy</sys:String>
    <sys:String x:Key="ErrAdv_cloud_classic_Summary">The Legacy (Python) engine cannot upload to the cloud.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_classic_Fix1">Switch to Native or Ferrite in Settings → Advanced.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_classic_Fix2">Or turn off cloud upload for this download.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_gdrive_Title">Google Drive folder not found</sys:String>
    <sys:String x:Key="ErrAdv_cloud_gdrive_Summary">VideoConverter uploads through the Google Drive for Desktop folder, which could not be found.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_gdrive_Fix1">Install Google Drive for Desktop and sign in.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_gdrive_Fix2">Or choose your Drive folder manually in Cloud Setup.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_onedrive_Title">OneDrive folder not found</sys:String>
    <sys:String x:Key="ErrAdv_cloud_onedrive_Summary">The OneDrive folder could not be found on this PC.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_onedrive_Fix1">Start OneDrive and sign in.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_onedrive_Fix2">Or choose your OneDrive folder manually in Cloud Setup.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_dropbox_auth_Title">Dropbox token invalid</sys:String>
    <sys:String x:Key="ErrAdv_cloud_dropbox_auth_Summary">Dropbox rejected the API token (expired or revoked).</sys:String>
    <sys:String x:Key="ErrAdv_cloud_dropbox_auth_Fix1">Create a new access token at dropbox.com/developers/apps (permission files.content.write).</sys:String>
    <sys:String x:Key="ErrAdv_cloud_dropbox_auth_Fix2">Paste it in Cloud Setup → Dropbox.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_dropbox_Title">Dropbox upload failed</sys:String>
    <sys:String x:Key="ErrAdv_cloud_dropbox_Summary">Dropbox could not receive the file.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_dropbox_Fix1">Check the API token in Cloud Setup, or install the Dropbox desktop app and use its folder.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_dropbox_Fix2">Dropbox's full answer is shown below.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_empty_Title">Webhook URL missing</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_empty_Summary">Webhook upload is selected, but no URL is set.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_empty_Fix1">Discord: Server settings → Integrations → Webhooks → Copy Webhook URL.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_empty_Fix2">Paste it in Cloud Setup → Webhook.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_large_Title">File too large for the webhook</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_large_Summary">The server rejected the file because it is too big (Discord allows 10 MB without Nitro).</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_large_Fix1">Choose a lower quality, or upload to Google Drive, Dropbox or OneDrive instead.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_Title">Webhook upload failed</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_Summary">The webhook server rejected the upload.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_Fix1">Check the URL in Cloud Setup – it must start with https://.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_webhook_Fix2">Discord: make sure the webhook still exists.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_custom_Title">Cloud folder missing</sys:String>
    <sys:String x:Key="ErrAdv_cloud_custom_Summary">The custom cloud folder does not exist or is not set.</sys:String>
    <sys:String x:Key="ErrAdv_cloud_custom_Fix1">Choose an existing folder in Cloud Setup → Custom folder.</sys:String>
    <sys:String x:Key="ErrAdv_upload_native_Title">YouTube upload not available in Native</sys:String>
    <sys:String x:Key="ErrAdv_upload_native_Summary">The Native engine can only download.</sys:String>
    <sys:String x:Key="ErrAdv_upload_native_Fix1">Switch to Ferrite (recommended) or Legacy in Settings → Advanced, then start the upload again.</sys:String>
    <sys:String x:Key="ErrAdv_upload_credentials_Title">YouTube API credentials missing</sys:String>
    <sys:String x:Key="ErrAdv_upload_credentials_Summary">YouTube upload needs an OAuth client file (client_secret.json) from Google.</sys:String>
    <sys:String x:Key="ErrAdv_upload_credentials_Fix1">Google Cloud Console → APIs &amp; Services → enable 'YouTube Data API v3'.</sys:String>
    <sys:String x:Key="ErrAdv_upload_credentials_Fix2">Credentials → Create credentials → OAuth client ID → Desktop app → Download JSON.</sys:String>
    <sys:String x:Key="ErrAdv_upload_credentials_Fix3">Save it as client_secret.json in the folder named in the error message below.</sys:String>
    <sys:String x:Key="ErrAdv_upload_quota_Title">YouTube quota reached</sys:String>
    <sys:String x:Key="ErrAdv_upload_quota_Summary">Your Google API project has used up its daily upload quota.</sys:String>
    <sys:String x:Key="ErrAdv_upload_quota_Fix1">Wait until the quota resets (midnight Pacific time) and try again.</sys:String>
    <sys:String x:Key="ErrAdv_upload_quota_Fix2">Or request a higher quota in the Google Cloud Console.</sys:String>
    <sys:String x:Key="ErrAdv_upload_signin_Title">YouTube sign-in failed</sys:String>
    <sys:String x:Key="ErrAdv_upload_signin_Summary">Google did not accept the sign-in or the saved token.</sys:String>
    <sys:String x:Key="ErrAdv_upload_signin_Fix1">Delete token.json (next to client_secret.json) and upload again to sign in fresh.</sys:String>
    <sys:String x:Key="ErrAdv_upload_signin_Fix2">In the browser, allow the permission to manage your YouTube videos.</sys:String>
    <sys:String x:Key="ErrAdv_upload_api_Title">YouTube rejected the upload</sys:String>
    <sys:String x:Key="ErrAdv_upload_api_Summary">The YouTube API returned an error.</sys:String>
    <sys:String x:Key="ErrAdv_upload_api_Fix1">Read the reason below (e.g. invalid title or tags) and adjust the upload.</sys:String>
    <sys:String x:Key="ErrAdv_upload_api_Fix2">Make sure your YouTube channel is verified for uploads.</sys:String>
    <sys:String x:Key="ErrAdv_network_Title">Network problem</sys:String>
    <sys:String x:Key="ErrAdv_network_Summary">The connection to the website failed or timed out.</sys:String>
    <sys:String x:Key="ErrAdv_network_Fix1">Check your internet connection and try again.</sys:String>
    <sys:String x:Key="ErrAdv_network_Fix2">Turn off VPN/proxy for a moment, or allow VideoConverter, yt-dlp and ffmpeg in your firewall.</sys:String>
    <sys:String x:Key="ErrAdv_upload_cancelled_Title">Upload stopped</sys:String>
    <sys:String x:Key="ErrAdv_upload_cancelled_Summary">The cloud upload was cancelled or took longer than 10 minutes.</sys:String>
    <sys:String x:Key="ErrAdv_upload_cancelled_Fix1">Start the job again; very large files may need a faster connection.</sys:String>
    <sys:String x:Key="ErrAdv_cancelled_Title">Cancelled</sys:String>
    <sys:String x:Key="ErrAdv_cancelled_Summary">The job was cancelled. Nothing is broken.</sys:String>
    <sys:String x:Key="ErrAdv_cancelled_Fix1">Start it again whenever you like.</sys:String>
    <sys:String x:Key="ErrAdv_unknown_Title">Something went wrong</sys:String>
    <sys:String x:Key="ErrAdv_unknown_Summary">An unexpected error occurred.</sys:String>
    <sys:String x:Key="ErrAdv_unknown_Fix1">Read the error message below – it usually names the cause.</sys:String>
    <sys:String x:Key="ErrAdv_unknown_Fix2">Open the console (Show Logs) for the complete output.</sys:String>
    <sys:String x:Key="ErrAdv_unknown_Fix3">Try again, or switch the engine in Settings → Advanced.</sys:String>
