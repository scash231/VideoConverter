                        <!-- ── About → What's New → one big version's releases (sub-page, opened from a version row) ── -->
                        <StackPanel x:Name="PaneVersion" Visibility="Collapsed">
                            <TextBlock x:Name="TxtVersionInfo" Style="{StaticResource Sub}" Margin="2,0,0,14"/>
                            <Border Style="{StaticResource Group}">
                                <ItemsControl x:Name="VersionReleases" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Border x:Name="RowSep" Style="{StaticResource Sep}"/>
                                                <Button Style="{StaticResource NavRow}" Click="OpenRelease_Click">
                                                    <DockPanel Style="{StaticResource Row}">
                                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Release.Date}"/>
                                                        <Border x:Name="CurrentChip" DockPanel.Dock="Right" Visibility="Collapsed" Background="{DynamicResource Accent}" CornerRadius="5"
                                                                Padding="6,1,6,2" Margin="8,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{DynamicResource PrefCurrentVersion}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                        <StackPanel Style="{StaticResource LabelStack}">
                                                            <TextBlock Style="{StaticResource LabelInStack}" Text="{Binding Release.Version}"/>
                                                            <TextBlock Style="{StaticResource Sub}" Text="{Binding Preview}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                    <Setter TargetName="RowSep" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="CurrentChip" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- ── About → one release's notes (sub-page, opened from a What's New row) ── -->
                        <StackPanel x:Name="PaneRelease" Visibility="Collapsed">
                            <TextBlock x:Name="TxtReleaseDate" Style="{StaticResource Sub}" Margin="2,0,0,14"/>
                            <ItemsControl x:Name="ReleaseSections" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Header}" Text="{Binding Title}"/>
                                            <Border Style="{StaticResource Group}" Padding="14,12,14,9">
                                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="12"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="•" FontSize="12.5" Foreground="{DynamicResource TextSec}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5" LineHeight="17"
                                                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
                </Grid>
                </Border>
            </Grid>

            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="32" Height="32"
                    Background="Transparent" Cursor="SizeNWSE"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style corner: arc along the window's rounded corner, lens on hover -->
                <controls:CornerResizeGlyph/>
            </Border>

            <!-- ══════ Alert sheet (restart, reset, uninstall) ══════ -->
            <Grid x:Name="Sheet" Visibility="Collapsed" Panel.ZIndex="10000" Grid.ColumnSpan="2">
                <Border Background="#40000000" MouseLeftButtonDown="SheetBackdrop_MouseDown"/>
                <Border x:Name="SheetCard" controls:LiquidGlass.Surface="Dialog" controls:LiquidGlass.Backdrop="{Binding ElementName=ContentHost}" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="14" Background="{DynamicResource PopupBg}"
                        BorderBrush="{DynamicResource PopupBorder}" BorderThickness="0.5"
                        Padding="20,20,20,16" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" Opacity="0.3" Color="Black" ShadowDepth="8" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="SheetTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SheetMessage" FontSize="12" Foreground="{DynamicResource TextSec}"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,18"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="SheetCancel" Style="{StaticResource Push}" Height="28" Margin="0,0,4,0"
                                    Content="{DynamicResource PrefCancel}" Click="SheetCancel_Click"/>
                            <Button x:Name="SheetConfirm" Style="{StaticResource PushPrimary}" Height="28" Margin="4,0,0,0"
                                    Click="SheetConfirm_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </helpers:SquircleBorder>
</Window>
