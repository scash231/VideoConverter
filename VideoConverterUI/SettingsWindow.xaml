<Window x:Class="VideoConverterUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:VideoConverterUI.Services"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        xmlns:anim="clr-namespace:VideoConverterUI.Animations"
        Title="{DynamicResource SettingsTitle}" Width="680" Height="500"
        Icon="Icons/Settings.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Assets/FormStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- ══════ Sidebar ══════ -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="10,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="6,0" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint0D}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnMedia}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Colored icon tile in front of each sidebar item -->
        <Style x:Key="NavTile" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavGlyph" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Filled" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>


        <!-- A whole row that opens a sub-page (iOS-style "Name   Value  >") -->
        <Style x:Key="NavRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint08}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint14}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Highlight over the Software Update app icon (drawn on the accent fill, so a fixed white) -->
        <LinearGradientBrush x:Key="UpdateIconGloss" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
            <GradientStop Color="#14000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- Red "1" while an update waits (General in the sidebar, the Software Update row) -->
        <Style x:Key="UpdateBadge" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#FF3B30"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>

        <!-- Text link in the accent colour ("More Info…") -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pop-up menus sit at the right end of their row -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="170"/>
        </Style>

        <!-- Segment inside the size presets control -->
        <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource Push}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <helpers:SquircleBorder x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="100" RenderTransformOrigin="0.5,0.5">
        <helpers:SquircleBorder.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </helpers:SquircleBorder.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar ═══ -->
            <!-- Liquid Glass (surface "Sidebar") floating over the content: the content area runs on underneath it
                 (ContentHost spans both columns), so pages sliding left during a push/pop pass under the glass, and the
                 lensing rim catches the colour and light of the cards next to it. The Border carries the shadow. -->
            <Border Grid.Column="0" Margin="8" Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.14"/>
                </Border.Effect>
            <controls:LiquidGlassPanel Surface="Sidebar" BackdropSource="{Binding ElementName=ContentLayer}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,12">
                    <StackPanel x:Name="NavList">
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource NavTile}" Background="#8E8E93"><ui:SymbolIcon Symbol="Settings24" Style="{StaticResource NavGlyph}"/></Border>
                                    <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefGeneral}"/>
                                </StackPanel>
                                <!-- Red badge while an update is waiting (General → Software Update), like System Settings (UpdateUpdateUi) -->
                                <Border x:Name="NavGeneralBadge" Style="{StaticResource UpdateBadge}" HorizontalAlignment="Right">
                                    <TextBlock Text="1" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#3A3A3C"><ui:SymbolIcon Symbol="DarkTheme24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefAppearance}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavGlassLayout" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#00C7BE"><ui:SymbolIcon Symbol="Blur24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefGlassLayout}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAnimations" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#AF52DE"><ui:SymbolIcon Symbol="Flash24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefAnimations}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavNotifications" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#FF3B30"><ui:SymbolIcon Symbol="Alert24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefNotifications}"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="12"/>
                        <RadioButton x:Name="NavDownloads" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#007AFF"><ui:SymbolIcon Symbol="ArrowDownload24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefDownloads}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMulti" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#FF9500"><ui:SymbolIcon Symbol="Stack24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefMulti}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavYouTube" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#FF2D55"><ui:SymbolIcon Symbol="Play24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefYouTube}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCloud" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#32ADE6"><ui:SymbolIcon Symbol="Cloud24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefCloud}"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="12"/>
                        <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#636366"><ui:SymbolIcon Symbol="Gauge24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefAdvanced}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDeveloper" Style="{StaticResource NavItem}" Checked="Nav_Checked" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#48484A"><ui:SymbolIcon Symbol="WrenchScrewdriver24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefDeveloper}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource NavTile}" Background="#8E8E93"><ui:SymbolIcon Symbol="Info24" Style="{StaticResource NavGlyph}"/></Border>
                                <TextBlock Style="{StaticResource NavText}" Text="{DynamicResource PrefAbout}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </controls:LiquidGlassPanel>
            </Border>

            <!-- ═══ Pane ═══ -->
            <!-- Spans both columns so the content runs under the sidebar; the pages' left margin (TabContentGrid)
                 keeps them beside it at rest. -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Close button: a small Liquid Glass circle (surface "Button") floating over the content, top right.
                     Its backdrop is the scroll area under it; the content also gets a round hole behind it
                     (ClipContentAroundClose), so only the glass's copy of it shows there. The Border carries the shadow. -->
                <Border x:Name="CloseGlass" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="5" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.18"/>
                    </Border.Effect>
                    <controls:LiquidGlassPanel Surface="Button" CornerRadius="14" BackdropSource="{Binding ElementName=ContentLayer}">
                        <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Padding="0"
                                ToolTip="{DynamicResource PrefClose}" Click="Close_Click">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                    </controls:LiquidGlassPanel>
                </Border>

                <!-- Back button of a sub-page (e.g. Appearance → Liquid Glass): the close button's twin on the left,
                     with a round hole behind it in the content too (ClipContentAroundClose). -->
                <Border x:Name="BackGlass" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="5" Width="28" Height="28"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="214,12,0,0" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.18"/>
                    </Border.Effect>
                    <controls:LiquidGlassPanel Surface="Button" CornerRadius="14" BackdropSource="{Binding ElementName=ContentLayer}">
                        <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Padding="0"
                                ToolTip="{DynamicResource PrefBack}" Click="Back_Click">
                            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                    </controls:LiquidGlassPanel>
                </Border>
                <!-- Title of the pane shown (the sidebar name, or a sub-page's own title); set in ShowPane / OpenSubPage -->
                <TextBlock x:Name="TxtPaneTitle" Grid.Row="0" Panel.ZIndex="5" IsHitTestVisible="False" Text="{DynamicResource PrefGeneral}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="200,17,0,0"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <!-- Soft window-coloured gradient behind the title (and the close/back buttons) so they stay readable
                     over scrolled content; fades in with the scroll offset (UpdateHeaderScrim), invisible at the top. -->
                <Border x:Name="HeaderScrim" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="4" IsHitTestVisible="False" Opacity="0"
                        Height="72" VerticalAlignment="Top" Margin="200,1,8,0" Background="{DynamicResource BgDeep}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F0000000" Offset="0"/>
                            <GradientStop Color="#C8000000" Offset="0.45"/>
                            <GradientStop Color="#50000000" Offset="0.75"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <!-- Content fades out softly at the top and bottom edges. The mask sits on a full-size host:
                     on the ScrollViewer itself it would follow the content's bounds. -->
                <Border x:Name="ContentHost" Grid.Row="0" Grid.RowSpan="2" Margin="8,0,8,8" Background="Transparent" ClipToBounds="True">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.025"/>
                            <GradientStop Color="Black" Offset="0.96"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                <!-- What the glass on top shows (sidebar, close/back): the page and, mid-slide, the outgoing one -->
                <Grid x:Name="ContentLayer">
                <!-- The outgoing page of a sub-page push/pop, frozen as it was on screen (SnapshotContent). It slides out
                     underneath the real page: a pushed page comes in over it, and going back it slips under the parent's rows. -->
                <Image x:Name="PageSnapshot" Panel.ZIndex="-1" Visibility="Collapsed" IsHitTestVisible="False" Stretch="Fill"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <ScrollViewer x:Name="TabContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="TabContentGrid" Margin="208,48,12,24">

                        <!-- ── General ── -->
                        <StackPanel x:Name="PaneGeneral">
                            <!-- General → Software Update (sub-page PaneUpdate), like System Settings -->
                            <Border Style="{StaticResource Group}">
                                <Button Style="{StaticResource NavRow}" Click="OpenUpdate_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <Border x:Name="UpdateRowBadge" Style="{StaticResource UpdateBadge}" DockPanel.Dock="Right" Margin="8,0,0,0">
                                            <TextBlock Text="1" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="TxtUpdateRowValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefSoftwareUpdate}"/>
                                    </DockPanel>
                                </Button>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbLanguage" Width="140">
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="Deutsch" Tag="de"/>
                                            <ComboBoxItem Content="Русский" Tag="ru"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefLanguage}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkAlwaysOnTop" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefKeepOnTop}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefLinksHeader}"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkAutoPaste" Style="{StaticResource Switch}"/>
                                        <StackPanel Style="{StaticResource LabelStack}">
                                            <TextBlock Style="{StaticResource LabelInStack}" Text="{DynamicResource PrefAutoPaste}"/>
                                            <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource PrefAutoPasteSub}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkAutoFetch" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefAutoFetch}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefErrorsHeader}"/>
                            <Border Style="{StaticResource Group}">
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="ChkAutoOpenErrorWindow" Style="{StaticResource Switch}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefShowErrors}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Software Update ── -->
                        <!-- Like System Settings → Software Update: automatic updates on top, then either the state centred
                             under it (checking, up to date, couldn't check) or the update to install as a card.
                             Filled in by SettingsWindow.Update.cs (UpdateUpdateUi) from UpdateService. -->
                        <StackPanel x:Name="PaneUpdate" Visibility="Collapsed">
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkAutoCheckUpdates" Style="{StaticResource Switch}"/>
                                        <StackPanel Style="{StaticResource LabelStack}">
                                            <TextBlock Style="{StaticResource LabelInStack}" Text="{DynamicResource PrefAutoUpdates}"/>
                                            <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource PrefAutoUpdatesSub}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock x:Name="TxtUpdateChannel" Style="{StaticResource Value}" DockPanel.Dock="Right"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefUpdateChannel}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Checking / up to date / couldn't check -->
                            <StackPanel x:Name="UpdateStatus" HorizontalAlignment="Center" Margin="0,22,0,8">
                                <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <!-- The app's icon: an accent tile with a soft top highlight -->
                                    <helpers:SquircleBorder Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Accent}">
                                        <helpers:SquircleBorder.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.22"/>
                                        </helpers:SquircleBorder.Effect>
                                        <helpers:SquircleBorder CornerRadius="16" Background="{StaticResource UpdateIconGloss}">
                                            <Grid><ui:SymbolIcon Symbol="ArrowDownload24" Filled="True" FontSize="30" Foreground="White"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                        </helpers:SquircleBorder>
                                    </helpers:SquircleBorder>
                                    <!-- Up to date: a green check on the icon's corner; couldn't check: an orange one -->
                                    <Border x:Name="UpdateStatusBadge" Width="22" Height="22" CornerRadius="11" Background="#34C759"
                                            BorderBrush="{DynamicResource BgDeep}" BorderThickness="2"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6">
                                        <Grid><ui:SymbolIcon x:Name="UpdateStatusGlyph" Symbol="Checkmark24" Filled="True" FontSize="11" Foreground="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TxtUpdateTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340"/>
                                <TextBlock x:Name="TxtUpdateDetail" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center"
                                           Margin="0,4,0,0" MaxWidth="340"/>
                                <StackPanel x:Name="UpdateChecking" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Grid Width="14" Height="14" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><RotateTransform x:Name="UpdateSpinnerTurn"/></Grid.RenderTransform>
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Foreground="{DynamicResource TextSec}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Sub}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource PrefUpdateChecking}"/>
                                </StackPanel>
                                <Button x:Name="BtnCheckNow" Style="{StaticResource Push}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                        Content="{DynamicResource PrefUpdateCheckNow}" Click="CheckNow_Click"/>
                            </StackPanel>

                            <!-- An update to install -->
                            <StackPanel x:Name="UpdateAvailablePanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefUpdateAvailable}"/>
                                <Border Style="{StaticResource Group}">
                                    <Grid Margin="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <helpers:SquircleBorder Width="44" Height="44" CornerRadius="11" Background="{DynamicResource Accent}" VerticalAlignment="Top">
                                            <helpers:SquircleBorder CornerRadius="11" Background="{StaticResource UpdateIconGloss}">
                                                <Grid><ui:SymbolIcon Symbol="ArrowDownload24" Filled="True" FontSize="21" Foreground="White"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                            </helpers:SquircleBorder>
                                        </helpers:SquircleBorder>
                                        <StackPanel Grid.Column="1" Margin="12,1,12,0">
                                            <TextBlock x:Name="TxtUpdateVersion" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtUpdateMeta" Style="{StaticResource Sub}"/>
                                            <Button x:Name="BtnUpdateMoreInfo" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,5,0,0"
                                                    Content="{DynamicResource PrefUpdateMoreInfo}" Click="UpdateMoreInfo_Click"/>
                                            <!-- While the installer downloads -->
                                            <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,9,0,0">
                                                <Grid Height="4">
                                                    <Border CornerRadius="2" Background="{DynamicResource Tint1F}"/>
                                                    <Border CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform><ScaleTransform x:Name="UpdateProgressScale" ScaleX="0"/></Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="TxtUpdateProgress" Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="BtnUpdateNow" Grid.Column="2" Style="{StaticResource PushPrimary}" VerticalAlignment="Top" Margin="0,2,0,0"
                                                Content="{DynamicResource PrefUpdateNow}" Click="UpdateNow_Click"/>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefUpdateFooter}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── Appearance ── -->
                        <StackPanel x:Name="PaneAppearance" Visibility="Collapsed">
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <!-- Dark / Light tiles are built in code (BuildModeTiles) -->
                                        <StackPanel x:Name="ModeTiles" Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,10"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefAppearance}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefAccentColor}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <Button Style="{StaticResource NavRow}" Click="OpenLiquidGlass_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtLiquidGlassValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefLiquidGlass}"/>
                                    </DockPanel>
                                </Button>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefLiquidGlassSub}"/>

                            <Border Style="{StaticResource Group}">
                                <Button Style="{StaticResource NavRow}" Click="OpenVideoColors_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVideoColorsValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefVideoColorsHeader}"/>
                                    </DockPanel>
                                </Button>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefVideoColorsSub}"/>

                            <Border Style="{StaticResource Group}">
                                <Button Style="{StaticResource NavRow}" Click="OpenColors_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="{DynamicResource PrefColorsHeader}"/>
                                            <Border CornerRadius="4" Padding="4,0" Margin="6,1,0,0" VerticalAlignment="Center" BorderThickness="0.75"
                                                    BorderBrush="{DynamicResource TextSec}" Opacity="0.6">
                                                <TextBlock Text="{DynamicResource PrefBeta}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSec}"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefColorsSub}"/>
                        </StackPanel>

                        <!-- ── Appearance → Liquid Glass (sub-page, opened from the row in Appearance) ── -->
                        <StackPanel x:Name="PaneLiquidGlass" Visibility="Collapsed">
                            <!-- Preview: a colourful scene with real glass floating over it -->
                            <Border Style="{StaticResource Group}" Padding="0" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True">
                                <Grid Height="180">
                                    <Grid x:Name="GlassPreviewScene">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF7A45" Offset="0"/>
                                                <GradientStop Color="#FF3D7F" Offset="0.35"/>
                                                <GradientStop Color="#7B5CFF" Offset="0.7"/>
                                                <GradientStop Color="#1FA2FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <Ellipse Width="150" Height="150" Fill="#FFD60A" Opacity="0.85" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,40,0"/>
                                        <Ellipse Width="110" Height="110" Fill="#30D158" Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,-30"/>
                                        <StackPanel VerticalAlignment="Center" Margin="22,0,0,10">
                                            <TextBlock Text="VideoConverter" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="Liquid Glass" FontSize="15" FontWeight="SemiBold" Foreground="White" Opacity="0.9"/>
                                        </StackPanel>
                                    </Grid>
                                    <controls:LiquidGlassPanel Surface="Popup" BackdropSource="{Binding ElementName=GlassPreviewScene}"
                                                               Width="34" Height="34" CornerRadius="17" Margin="14,14,0,0"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Navigation24" FontSize="14" Foreground="{DynamicResource TextPrimary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </controls:LiquidGlassPanel>
                                    <controls:LiquidGlassPanel Surface="Popup" BackdropSource="{Binding ElementName=GlassPreviewScene}"
                                                               Height="36" CornerRadius="18" Margin="14,0,14,14" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Search24" FontSize="13" Foreground="{DynamicResource TextSec}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource PrefGlassPreviewSearch}" FontSize="12.5" Foreground="{DynamicResource TextSec}"/>
                                        </StackPanel>
                                    </controls:LiquidGlassPanel>
                                </Grid>
                            </Border>

                            <!-- Clear ↔ Tinted -->
                            <Border Style="{StaticResource Group}">
                                <StackPanel Margin="12,12,12,8">
                                    <DockPanel>
                                        <ui:SymbolIcon Symbol="Circle24" DockPanel.Dock="Left" FontSize="15" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="Circle24" Filled="True" DockPanel.Dock="Right" FontSize="15" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderLiquidGlass" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="{DynamicResource PrefGlassClear}" FontSize="11" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="TxtLiquidGlassState" FontSize="11" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource PrefGlassTinted}" FontSize="11" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Push}" HorizontalAlignment="Left" Margin="2,-10,0,0" Content="{DynamicResource PrefGlassResetDefault}"
                                    Click="ResetLiquidGlass_Click"/>

                            <!-- Text readability: its own page (the wash that fades in behind text where the backdrop would wash it out) -->
                            <Border Style="{StaticResource Group}" Margin="0,22,0,22">
                                <Button Style="{StaticResource NavRow}" Click="OpenGlassReadability_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtGlassReadabilityValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="{DynamicResource PrefGlassReadability}"/>
                                            <Border CornerRadius="4" Padding="4,0" Margin="6,1,0,0" VerticalAlignment="Center" BorderThickness="0.75"
                                                    BorderBrush="{DynamicResource TextSec}" Opacity="0.6">
                                                <TextBlock Text="{DynamicResource PrefBeta}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSec}"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </Border>
                        </StackPanel>

                        <!-- ── Appearance → Liquid Glass → Text readability (sub-page of the sub-page) ── -->
                        <StackPanel x:Name="PaneGlassReadability" Visibility="Collapsed">
                            <!-- Preview: glass over a background that is bright on one side, dark on the other and busy throughout,
                                 so the dimming shows where it kicks in and follows the strength slider -->
                            <Border Style="{StaticResource Group}" Padding="0" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True">
                                <Grid Height="170">
                                    <Grid x:Name="ReadabilityPreviewScene">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#FFE27A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Column="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3A2470" Offset="0"/>
                                                    <GradientStop Color="#0B1020" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Ellipse Grid.ColumnSpan="2" Width="130" Height="130" Fill="#FF3D7F" HorizontalAlignment="Center"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,-50"/>
                                        <!-- "Text" behind the glass: lines of a page on each side -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="22,0,14,22">
                                            <Border Height="9" Width="120" CornerRadius="4" Background="#2A2A2A" HorizontalAlignment="Left" Margin="0,0,0,7"/>
                                            <Border Height="7" CornerRadius="3.5" Background="#555555" Margin="0,0,20,6"/>
                                            <Border Height="7" CornerRadius="3.5" Background="#555555" Margin="0,0,50,6"/>
                                            <Border Height="7" CornerRadius="3.5" Background="#555555" Margin="0,0,10,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="14,0,22,22">
                                            <Border Height="9" Width="110" CornerRadius="4" Background="#F2F2F2" HorizontalAlignment="Left" Margin="0,0,0,7"/>
                                            <Border Height="7" CornerRadius="3.5" Background="#BBBBBB" Margin="0,0,30,6"/>
                                            <Border Height="7" CornerRadius="3.5" Background="#BBBBBB" Margin="0,0,8,6"/>
                                            <Border Height="7" CornerRadius="3.5" Background="#BBBBBB" Margin="0,0,40,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <controls:LiquidGlassPanel Surface="Popup" BackdropSource="{Binding ElementName=ReadabilityPreviewScene}"
                                                               Height="62" CornerRadius="20" Margin="16,0,16,16" VerticalAlignment="Bottom">
                                        <StackPanel Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource PrefReadabilityPreviewTitle}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{DynamicResource PrefReadabilityPreviewSub}" FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSec}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </controls:LiquidGlassPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="ChkGlassAutoDim" Style="{StaticResource Switch}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefGlassAutoDim}"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefGlassAutoDimHelp}"/>

                            <!-- Strength and how quickly it adapts: only while it is on -->
                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=ChkGlassAutoDim}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefGlassDimStrength}"/>
                                <Border Style="{StaticResource Group}">
                                    <StackPanel Margin="12,12,12,8">
                                        <Slider x:Name="SliderDimStrength" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                VerticalAlignment="Center"/>
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="{DynamicResource PrefGlassDimSofter}" FontSize="11" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="TxtDimStrengthState" FontSize="11" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource PrefGlassDimStronger}" FontSize="11" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefGlassDimStrengthHelp}"/>

                                <Border Style="{StaticResource Group}">
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkGlassDimTextOnly" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefGlassDimTextOnly}"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefGlassDimTextOnlyHelp}"/>

                                <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefGlassSampling}"/>
                                <Border Style="{StaticResource Group}">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbGlassSampling" Width="200">
                                            <ComboBoxItem Content="{DynamicResource PrefGlassSamplingTimer}" Tag="timer"/>
                                            <ComboBoxItem Content="{DynamicResource PrefGlassSamplingChanges}" Tag="changes"/>
                                            <ComboBoxItem Content="{DynamicResource PrefGlassSamplingBoth}" Tag="both"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefGlassSamplingRow}"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefGlassSamplingHelp}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── Appearance → Colors (sub-page, opened from the row in Appearance) ── -->
                        <StackPanel x:Name="PaneColors" Visibility="Collapsed">
                            <Border Style="{StaticResource Group}" Margin="0,0,0,10">
                                <StackPanel x:Name="ColorRows"/>
                            </Border>
                            <Border Style="{StaticResource Group}" Margin="0,0,0,10">
                                <StackPanel Margin="12,10,12,12">
                                    <DockPanel Margin="0,0,0,10">
                                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource Tint26}" Margin="0,0,10,0">
                                            <Border x:Name="ActiveSwatch" CornerRadius="10"/>
                                        </Border>
                                        <TextBlock x:Name="TxtActiveLabel" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtHueVal" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Style="{StaticResource Value}" FontSize="12"/>
                                        <TextBlock DockPanel.Dock="Left" Width="84" Style="{StaticResource Label}" FontSize="12" Text="{DynamicResource PrefHue}"/>
                                        <Slider x:Name="SliderHue" Minimum="0" Maximum="360" VerticalAlignment="Center" ValueChanged="SliderHsv_ValueChanged">
                                            <Slider.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF0000" Offset="0.00"/>
                                                    <GradientStop Color="#FFFF00" Offset="0.17"/>
                                                    <GradientStop Color="#00FF00" Offset="0.33"/>
                                                    <GradientStop Color="#00FFFF" Offset="0.50"/>
                                                    <GradientStop Color="#0000FF" Offset="0.67"/>
                                                    <GradientStop Color="#FF00FF" Offset="0.83"/>
                                                    <GradientStop Color="#FF0000" Offset="1.00"/>
                                                </LinearGradientBrush>
                                            </Slider.Background>
                                        </Slider>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtSatVal" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Style="{StaticResource Value}" FontSize="12"/>
                                        <TextBlock DockPanel.Dock="Left" Width="84" Style="{StaticResource Label}" FontSize="12" Text="{DynamicResource PrefSaturation}"/>
                                        <Slider x:Name="SliderSat" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="SliderHsv_ValueChanged"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtValVal" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Style="{StaticResource Value}" FontSize="12"/>
                                        <TextBlock DockPanel.Dock="Left" Width="84" Style="{StaticResource Label}" FontSize="12" Text="{DynamicResource PrefBrightness}"/>
                                        <Slider x:Name="SliderVal" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="SliderHsv_ValueChanged"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock x:Name="TxtAlphaVal" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Style="{StaticResource Value}" FontSize="12"/>
                                        <TextBlock DockPanel.Dock="Left" Width="84" Style="{StaticResource Label}" FontSize="12" Text="{DynamicResource PrefOpacity}"/>
                                        <Slider x:Name="SliderAlpha" Minimum="50" Maximum="100" VerticalAlignment="Center" ValueChanged="SliderHsv_ValueChanged"/>
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}" FontSize="12" Width="84" Text="Hex"/>
                                        <TextBox x:Name="TxtHexInput" Width="96" FontSize="12" FontFamily="Consolas" Padding="6,3" MaxLength="9" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource Label}" FontSize="12" Text="R" Margin="14,0,5,0"/>
                                        <TextBox x:Name="TxtR" Width="42" FontSize="12" Padding="2,3" MaxLength="3" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource Label}" FontSize="12" Text="G" Margin="8,0,5,0"/>
                                        <TextBox x:Name="TxtG" Width="42" FontSize="12" Padding="2,3" MaxLength="3" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource Label}" FontSize="12" Text="B" Margin="8,0,5,0"/>
                                        <TextBox x:Name="TxtB" Width="42" FontSize="12" Padding="2,3" MaxLength="3" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Palette: saved colors first (right-click removes), then the built-in ones -->
                                    <WrapPanel x:Name="PaletteGridPanel"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Push}" HorizontalAlignment="Right" Margin="0,0,0,22"
                                    Content="{DynamicResource PrefRestoreColors}" Click="RestoreColors_Click"/>
                        </StackPanel>

                        <!-- ── Appearance → Video colors (sub-page) ── -->
                        <StackPanel x:Name="PaneVideoColors" Visibility="Collapsed">
                            <!-- Preview: the main window's video card with a sample thumbnail, tinted the way the
                                 settings below would tint it (UpdateVideoColorsPreview). -->
                            <Border Style="{StaticResource Group}" Padding="0" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True">
                                <Grid Height="214">
                                    <Border x:Name="VcWindowBg"/>
                                    <Grid Margin="14,10,14,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="2,0,2,10">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Border Width="24" Height="14" CornerRadius="5" Background="{DynamicResource Tint14}" Margin="0,0,4,0"/>
                                                <Border Width="24" Height="14" CornerRadius="5" Background="{DynamicResource Tint14}"/>
                                            </StackPanel>
                                            <TextBlock Text="VideoConverter" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </DockPanel>
                                        <Border x:Name="VcCard" Grid.Row="1" CornerRadius="10" BorderThickness="0.5" Padding="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- The thumbnail container; its letterbox gaps show the tint -->
                                                <Border x:Name="VcThumbBg" Width="150" CornerRadius="7" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True">
                                                    <Grid x:Name="VcThumb" Width="62" ClipToBounds="True"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,4,0,0">
                                                    <Border Height="9" CornerRadius="3" Background="{DynamicResource Tint33}" Margin="0,0,18,6"/>
                                                    <Border Height="7" CornerRadius="3" Background="{DynamicResource Tint1A}" Margin="0,0,52,16"/>
                                                    <Border x:Name="VcStart" Height="24" Width="86" CornerRadius="8" HorizontalAlignment="Left">
                                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- Sample videos (built in BuildVideoSamples): click one to see its colors -->
                                        <controls:LiquidGlassPanel Grid.Row="2" Surface="Popup" BackdropSource="{Binding ElementName=VcWindowBg}"
                                                                   Height="30" CornerRadius="15" Margin="0,10,0,0" HorizontalAlignment="Center">
                                            <StackPanel x:Name="VcSamples" Orientation="Horizontal" Margin="7,0" VerticalAlignment="Center"/>
                                        </controls:LiquidGlassPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkAdaptiveTheme" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefTintFromVideo}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbGradEffectMode" Width="200">
                                            <ComboBoxItem Content="{DynamicResource PrefGradientCard}" Tag="thumbnail_only"/>
                                            <ComboBoxItem Content="{DynamicResource PrefGradientBoth}" Tag="both"/>
                                            <ComboBoxItem Content="{DynamicResource PrefGradientOff}" Tag="none"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefGradient}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefVideoColorsFooter}"/>
                        </StackPanel>

                        <!-- ── Glass & Layout → Window glass (sub-page) ── -->
                        <StackPanel x:Name="PaneWindowGlass" Visibility="Collapsed">
                            <!-- Preview: the main window on a desktop. Its body uses BgDeep and BorderSub, so opacity and
                                 borders show live. -->
                            <Border Style="{StaticResource Group}" Padding="0" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True">
                                <Grid x:Name="WgPreview" Height="200">
                                    <Grid x:Name="WgScene">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0F9B8E" Offset="0"/>
                                                <GradientStop Color="#2A6FDB" Offset="0.5"/>
                                                <GradientStop Color="#8E44EC" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <Ellipse Width="170" Height="170" Fill="#FFB340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,-50,0,0"/>
                                        <Ellipse Width="120" Height="120" Fill="#FF4F7B" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,-40"/>
                                        <TextBlock Text="Desktop" FontSize="56" FontWeight="Black" Foreground="White" Opacity="0.9"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
                                            <Border Width="22" Height="22" CornerRadius="5" Background="#F2F2F7" Margin="0,0,0,10"/>
                                            <Border Width="22" Height="22" CornerRadius="5" Background="#FFD60A" Margin="0,0,0,10"/>
                                            <Border Width="22" Height="22" CornerRadius="5" Background="#30D158"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="WgWindow" Width="250" Height="146" CornerRadius="11" BorderThickness="1"
                                            Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BorderSub}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.28"/>
                                        </Border.Effect>
                                        <StackPanel Margin="10,8,10,10">
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <Border Width="18" Height="10" CornerRadius="4" Background="{DynamicResource Tint14}" Margin="0,0,3,0"/>
                                                    <Border Width="18" Height="10" CornerRadius="4" Background="{DynamicResource Tint14}"/>
                                                </StackPanel>
                                                <TextBlock Text="VideoConverter" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            </DockPanel>
                                            <Border Height="20" CornerRadius="6" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}"
                                                    BorderThickness="0.5" Margin="0,0,0,7"/>
                                            <Border Height="52" CornerRadius="8" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}"
                                                    BorderThickness="0.5" Margin="0,0,0,7">
                                                <StackPanel Margin="8" VerticalAlignment="Center">
                                                    <Border Height="7" CornerRadius="3" Background="{DynamicResource Tint33}" Margin="0,0,40,6"/>
                                                    <Border Height="6" CornerRadius="3" Background="{DynamicResource Tint1A}" Margin="0,0,90,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Height="18" Width="90" CornerRadius="6" Background="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock x:Name="TxtGlassOpacityPct" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Style="{StaticResource Value}"/>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="{DynamicResource PrefWindowOpacity}"/>
                                        <Slider x:Name="SliderGlassOpacity" Minimum="50" Maximum="100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkEnableBorders" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefBorders}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefWindowGlassFooter}"/>
                        </StackPanel>

                        <!-- ── Glass & Layout → Toolbar buttons (sub-page) ── -->
                        <StackPanel x:Name="PaneToolbar" Visibility="Collapsed">
                            <!-- Preview: the main window's title bar at full size, scaled down to fit (it widens with labels on). The pills mirror
                                 MainWindow's header and come and go with the switches below (UpdateToolbarPreview). -->
                            <Border Style="{StaticResource Group}" Padding="0" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True">
                                <Grid Background="{DynamicResource Tint06}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="12,18">
                                        <Border MinWidth="600" Height="52" CornerRadius="12" Background="{DynamicResource BgDeep}"
                                                BorderBrush="{DynamicResource BorderSub}" BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.18"/>
                                            </Border.Effect>
                                            <DockPanel Margin="14,0,4,0">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <Border x:Name="TbHelp" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}"
                                                            BorderThickness="0.5" CornerRadius="8" Padding="4.7,0" Margin="0,0,4,0" Height="30.1">
                                                        <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Info28" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="TbHelpLabel" Text="Help" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSec}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="TbDev" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}"
                                                            BorderThickness="0.5" CornerRadius="8" Padding="4.7,0" Margin="0,0,4,0" Height="30.1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Code24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TbConsoleLabel" Text="Console" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSec}"/>
                                                            </StackPanel>
                                                            <Border Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="2,0" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TbLogLabel" Text="Log" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSec}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}"
                                                            BorderThickness="0.5" CornerRadius="8" Padding="4.7,0" Margin="0,0,6,0" Height="30.1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <StackPanel x:Name="TbEditor" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="Cut24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                                    <TextBlock x:Name="TbEditorLabel" Text="Editor" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSec}"/>
                                                                </StackPanel>
                                                                <Border Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="2,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Collections24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TbBatchLabel" Text="Batch" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSec}"/>
                                                            </StackPanel>
                                                            <Border Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="2,0" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Settings24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TbSettingsLabel" Text="Settings" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSec}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="TbLang" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}"
                                                            BorderThickness="0.5" CornerRadius="8" Padding="10,0" Margin="0,0,6,0" Height="30.1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock x:Name="TbLangCode" Text="EN" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                            <Border Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="6,0" VerticalAlignment="Center"/>
                                                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ui:SymbolIcon Symbol="Subtract24" FontSize="13" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="11,0"/>
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="11,0"/>
                                                </StackPanel>
                                                <TextBlock Text="VideoConverter" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,28,0"/>
                                            </DockPanel>
                                        </Border>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkPillHelp" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefPillHelp}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkPillDev" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefPillDev}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkPillEditor" Style="{StaticResource Switch}"/>
                                        <StackPanel Style="{StaticResource LabelStack}">
                                            <TextBlock Style="{StaticResource LabelInStack}" Text="{DynamicResource PrefWinEditor}"/>
                                            <TextBlock x:Name="TxtPillEditorNote" Style="{StaticResource Sub}" Text="{DynamicResource PrefPillEditorNeedsDev}" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkPillLang" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefLanguage}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="ChkShowIconLabels" Style="{StaticResource Switch}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefIconLabels}"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefToolbarFooter}"/>
                        </StackPanel>

                        <!-- ── Glass & Layout ── -->
                        <StackPanel x:Name="PaneGlassLayout" Visibility="Collapsed">
                            <Border Style="{StaticResource Group}">
                                <Button Style="{StaticResource NavRow}" Click="OpenWindowGlass_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtWindowGlassValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefWindowGlass}"/>
                                    </DockPanel>
                                </Button>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefWindowGlassSub}"/>

                            <Border Style="{StaticResource Group}">
                                <Button Style="{StaticResource NavRow}" Click="OpenToolbar_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtToolbarValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefToolbarHeader}"/>
                                    </DockPanel>
                                </Button>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefToolbarSub}"/>

                            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefLayoutHeader}"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkHideScrollbars" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefHideScrollbars}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkSmoothScrolling" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefSmoothScroll}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbAutoProgressMode">
                                            <ComboBoxItem Content="{DynamicResource PrefProgressOff}" Tag="disabled"/>
                                            <ComboBoxItem Content="{DynamicResource PrefProgressOnly}" Tag="show_progress"/>
                                            <ComboBoxItem Content="{DynamicResource PrefProgressLog}" Tag="show_with_log"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefProgressDetails}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <Button Style="{StaticResource NavRow}" Click="OpenWindowSizes_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtResizeHandleValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefWindowSizes}"/>
                                    </DockPanel>
                                </Button>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefWindowSizesSub}"/>
                        </StackPanel>

                        <!-- ── Animations ── -->
                        <StackPanel x:Name="PaneAnimations" Visibility="Collapsed">
                            <!-- Motion preview: one element, moved between this host and the Customize sub-page's
                                 (MoveMotionPreview); it replays whenever a motion option changes (PlayMotionPreview). -->
                            <Border x:Name="MotionPreviewHostMain" Style="{StaticResource Group}" Padding="0" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True">
                                <Grid x:Name="MotionPreview" Height="196" Background="{DynamicResource Tint06}" ClipToBounds="True">
                                    <Border x:Name="MpWindow" Width="214" Height="138" CornerRadius="11" BorderThickness="1"
                                            Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BorderSub}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="MpScale"/>
                                                <TranslateTransform x:Name="MpTranslate"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.22"/>
                                        </Border.Effect>
                                        <StackPanel x:Name="MpRows" Margin="10,9,10,10">
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <Border Width="16" Height="9" CornerRadius="4" Background="{DynamicResource Tint14}" Margin="0,0,3,0"/>
                                                    <Border Width="16" Height="9" CornerRadius="4" Background="{DynamicResource Tint14}"/>
                                                </StackPanel>
                                                <TextBlock Text="VideoConverter" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            </DockPanel>
                                            <Border Height="26" CornerRadius="7" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}"
                                                    BorderThickness="0.5" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                                    <Ellipse Width="11" Height="11" Fill="{DynamicResource Accent}"/>
                                                    <Border Width="96" Height="6" CornerRadius="3" Background="{DynamicResource Tint26}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Height="26" CornerRadius="7" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}"
                                                    BorderThickness="0.5" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                                    <Ellipse Width="11" Height="11" Fill="{DynamicResource SuccessGreen}"/>
                                                    <Border Width="70" Height="6" CornerRadius="3" Background="{DynamicResource Tint26}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Grid x:Name="MpTrack" Height="6" Margin="2,0">
                                                <Border CornerRadius="3" Background="{DynamicResource Tint14}"/>
                                                <Border x:Name="MpProgress" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <!-- Hover it for the hover zoom; click it to play the animation again. Morph opens the window from here. -->
                                    <Button x:Name="MpTryButton" Style="{StaticResource PushPrimary}" Content="{DynamicResource PrefMotionTry}"
                                            Height="26" Padding="14,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                            anim:MicroAnimationBehavior.IsEnabled="True" ToolTip="{DynamicResource PrefMotionReplay}"
                                            Click="ReplayMotion_Click"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="CmbAnimPreset" Width="140">
                                        <ComboBoxItem Content="{DynamicResource PrefMotionReduced}" Tag="Disabled (Static)"/>
                                        <ComboBoxItem Content="{DynamicResource PrefMotionSubtle}" Tag="Subtle"/>
                                        <ComboBoxItem Content="{DynamicResource PrefMotionBalanced}" Tag="Balanced"/>
                                        <ComboBoxItem Content="{DynamicResource PrefMotionFluid}" Tag="Smooth Liquid"/>
                                        <ComboBoxItem Content="{DynamicResource PrefMotionLiquid}" Tag="Liquid"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefMotionProfile}"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Group}">
                                <Button Style="{StaticResource NavRow}" Click="OpenMotion_Click">
                                    <DockPanel Style="{StaticResource Row}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" DockPanel.Dock="Right" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMotionValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefMotionCustomize}"/>
                                    </DockPanel>
                                </Button>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefMotionFooter}"/>
                        </StackPanel>

                        <!-- ── Animations → Customize (sub-page) ── -->
                        <StackPanel x:Name="PaneMotion" Visibility="Collapsed">
                            <Border x:Name="MotionPreviewHostDetail" Style="{StaticResource Group}" Padding="0" ClipToBounds="True" helpers:ClipHelper.CornerRadiusClip="True"/>

                            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefWindows}"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbWindowAnimStyle" Width="140">
                                            <ComboBoxItem Content="{DynamicResource PrefWindowStyleLiquid}" Tag="Liquid"/>
                                            <ComboBoxItem Content="{DynamicResource PrefWindowStyleMorph}" Tag="Morph &amp; Scale"/>
                                            <ComboBoxItem Content="{DynamicResource PrefWindowStyleSlide}" Tag="Slide Up &amp; Fade"/>
                                            <ComboBoxItem Content="{DynamicResource PrefWindowStyleZoom}" Tag="Zoom Elastic"/>
                                            <ComboBoxItem Content="{DynamicResource PrefWindowStyleFade}" Tag="Fade Only"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefWindowStyle}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbWindowAnimEasing" Width="140">
                                            <ComboBoxItem Content="{DynamicResource PrefEasingBouncy}" Tag="Apple Spring (Bouncy)"/>
                                            <ComboBoxItem Content="{DynamicResource PrefEasingInteractive}" Tag="Apple Spring"/>
                                            <ComboBoxItem Content="{DynamicResource PrefEasingSnappy}" Tag="Elastic Snap"/>
                                            <ComboBoxItem Content="{DynamicResource PrefEasingSmooth}" Tag="Cubic Smooth"/>
                                            <ComboBoxItem Content="{DynamicResource PrefEasingLinear}" Tag="Linear Constant"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefEasing}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock x:Name="TxtWinDurVal" DockPanel.Dock="Right" Width="56" TextAlignment="Right" Style="{StaticResource Value}"/>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="{DynamicResource PrefWindowSpeed}"/>
                                        <Slider x:Name="SliderWinDur" Minimum="100" Maximum="600" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefMotionDetailsHeader}"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkHoverMicro" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefHoverEffects}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding IsChecked, ElementName=ChkHoverMicro}">
                                        <TextBlock x:Name="TxtHoverScaleVal" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Style="{StaticResource Value}"/>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="{DynamicResource PrefHoverSize}"/>
                                        <Slider x:Name="SliderHoverScale" Minimum="1.00" Maximum="1.10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkStaggered" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefCascade}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkProgPulse" Style="{StaticResource Switch}"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefGlow}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Footer}" Text="{DynamicResource PrefMotionCustomizeFooter}"/>
                        </StackPanel>

                        <!-- ── Notifications ── -->
                        <StackPanel x:Name="PaneNotifications" Visibility="Collapsed">
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbCompletionNotificationMode">
                                            <ComboBoxItem Content="{DynamicResource PrefAlertOff}" Tag="off"/>
                                            <ComboBoxItem Content="{DynamicResource PrefAlertBanner}" Tag="notification_only"/>
                                            <ComboBoxItem Content="{DynamicResource PrefAlertBannerSound}" Tag="sound_and_notification"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefFinishedAlert}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ChkPlaylistDetectedNotification" Style="{StaticResource Switch}"/>
                                        <StackPanel Style="{StaticResource LabelStack}">
                                            <TextBlock Style="{StaticResource LabelInStack}" Text="{DynamicResource PrefPlaylistAlert}"/>
                                            <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource PrefPlaylistAlertSub}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefBannerHeader}"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbNotifyDurationInfo"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefBannerInfo}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbNotifyDurationError"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefBannerErrors}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Sep}"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="CmbNotifyDurationComplete"/>
                                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PrefBannerDone}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Shows a real banner of each kind, for as long as its duration above says -->
                            <TextBlock Style="{StaticResource Header}" Text="{DynamicResource PrefBannerTryHeader}"/>
                            <Border Style="{StaticResource Group}">
                                <DockPanel Style="{StaticResource Row}">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Push}" Margin="0,0,6,0" Tag="info" Click="PreviewBanner_Click"
                                                Content="{DynamicResource PrefBannerSampleInfo}"/>
                                        <Button Style="{StaticResource Push}" Margin="0,0,6,0" Tag="error" Click="PreviewBanner_Click"
                                                Content="{DynamicResource PrefBannerSampleError}"/>
                                        <Button Style="{StaticResource Push}" Tag="done" Click="PreviewBanner_Click"
