<Window x:Class="VideoConverterUI.DescriptionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:VideoConverterUI.Services"
        Title="{DynamicResource DescEditorTitle}" Width="760" Height="560"
        MinWidth="400" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="Icons/DescritpionEditor.ico">

    <helpers:SquircleBorder x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="100" RenderTransformOrigin="0.5,0.5">
        <helpers:SquircleBorder.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopScale"/>
                <TranslateTransform x:Name="PopTranslate"/>
            </TransformGroup>
        </helpers:SquircleBorder.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <TextBlock Text="{DynamicResource DescEditorTitle}" FontWeight="SemiBold"
                               FontSize="12" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Style="{StaticResource IconBtn}"
                            Foreground="{DynamicResource TextSec}"
                            Width="30" Height="30"
                            HorizontalAlignment="Right" Margin="0,0,4,0"
                            Click="Close_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Editor -->
            <TextBox x:Name="TxtEditor"
                     Grid.Row="1"
                     Margin="12,10,12,0"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalAlignment="Stretch"
                     FontSize="12"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="12,10,12,12">
                <Button Content="{DynamicResource BtnCancelSettings}" Style="{StaticResource OutlineBtn}"
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="{DynamicResource BtnApply}" Style="{StaticResource GradRectBtn}"
                        Width="110" Click="Apply_Click"/>
            </StackPanel>
            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="32" Height="32" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style corner: arc along the window's rounded corner, lens on hover -->
                <controls:CornerResizeGlyph/>
            </Border>
        </Grid>
    </helpers:SquircleBorder>
</Window>


