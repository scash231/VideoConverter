<Window x:Class="VideoConverterUI.CloudSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:VideoConverterUI.Services"
        Title="{DynamicResource CloudSetupTitle}" Width="520"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Storyboard x:Key="FadeInDialog">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.93" To="1" Duration="0:0:0.32"
                             BeginTime="0:0:0.02">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOutDialog">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="0.94" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="0.94" Duration="0:0:0.16"/>
        </Storyboard>

        <Style x:Key="SegmentPill" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCard}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <helpers:SquircleBorder x:Name="RootBorder" controls:LiquidGlass.Surface="Dialog" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <helpers:SquircleBorder.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </helpers:SquircleBorder.RenderTransform>

        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Provider Selector Tabs -->
                <RowDefinition Height="Auto"/>
                <!-- Provider Config Body -->
                <RowDefinition Height="Auto"/>
                <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- ═══ Title Bar ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource CloudSetupTitle}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource IconBtn}"
                        Click="Close_Click" Width="28" Height="28"
                        VerticalAlignment="Center" ToolTip="{DynamicResource TipClose}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{DynamicResource TextSec}"/>
                </Button>
            </Grid>

            <!-- ═══ Provider Switcher Pills ═══ -->
            <Border Grid.Row="1" Background="{DynamicResource InputBg}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
                    Padding="4" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="TabGDrive" Content="Google Drive" IsChecked="True"
                                 Style="{StaticResource SegmentPill}" Click="ProviderTab_Click"/>
                    <RadioButton Grid.Column="1" x:Name="TabDropbox" Content="Dropbox"
                                 Style="{StaticResource SegmentPill}" Click="ProviderTab_Click"/>
                    <RadioButton Grid.Column="2" x:Name="TabOneDrive" Content="OneDrive"
                                 Style="{StaticResource SegmentPill}" Click="ProviderTab_Click"/>
                    <RadioButton Grid.Column="3" x:Name="TabWebhook" Content="Discord"
                                 Style="{StaticResource SegmentPill}" Click="ProviderTab_Click"/>
                </Grid>
            </Border>

            <!-- ═══ Config Panels ═══ -->
            <Grid Grid.Row="2" Margin="0,0,0,16" MinHeight="160">
                <!-- GOOGLE DRIVE PANEL -->
                <StackPanel x:Name="PanelGDrive" Visibility="Visible">
                    <TextBlock Text="Google Drive Desktop Folder" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtGDrivePath" Height="30" FontSize="11"
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 Tag="Auto-detected or custom Google Drive folder"/>
                        <Button Grid.Column="1" Style="{StaticResource OutlineBtn}" Height="30"
                                Content="Auto-Detect" Margin="6,0,0,0" Padding="10,0"
                                Click="AutoDetectGDrive_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource OutlineBtn}" Height="30"
                                Content="Browse..." Margin="6,0,0,0" Padding="12,0"
                                Click="BrowseGDrive_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtGDriveStatus" Text="Status: Checking..." FontSize="10"
                               Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"
                               Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource Tint10}" BorderBrush="{DynamicResource Tint15}" BorderThickness="0.5" CornerRadius="8" Padding="10,8">
                        <TextBlock Text="Videos are saved into a 'VideoConverter' folder inside your Google Drive. Google Drive for Desktop syncs the file instantly to your cloud."
                                   FontSize="9.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- DROPBOX PANEL -->
                <StackPanel x:Name="PanelDropbox" Visibility="Collapsed">
                    <TextBlock Text="Direct API Upload (Personal Access Token)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdDropboxToken" Height="30" FontSize="11"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Get a token at dropbox.com/developers/apps" FontSize="9.5"
                                   Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource OutlineBtn}" Height="26"
                                Content="Test API Token" Padding="10,0" Click="TestDropbox_Click" Margin="379,7,0,-7"/>
                    </Grid>

                    <TextBlock Text="Or Local Dropbox Sync Folder" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDropboxPath" Height="30" FontSize="11"
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 Tag="C:\Users\Username\Dropbox"/>
                        <Button Grid.Column="1" Style="{StaticResource OutlineBtn}" Height="30"
                                Content="Browse..." Margin="8,0,0,0" Padding="12,0"
                                Click="BrowseDropbox_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtDropboxStatus" Text="Status: Ready" FontSize="10"
                               Foreground="{DynamicResource TextSec}" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- ONEDRIVE PANEL -->
                <StackPanel x:Name="PanelOneDrive" Visibility="Collapsed">
                    <TextBlock Text="Microsoft OneDrive Sync Folder" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOneDrivePath" Height="30" FontSize="11"
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 Tag="C:\Users\Username\OneDrive"/>
                        <Button Grid.Column="1" Style="{StaticResource OutlineBtn}" Height="30"
                                Content="Auto-Detect" Margin="6,0,0,0" Padding="10,0"
                                Click="AutoDetectOneDrive_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource OutlineBtn}" Height="30"
                                Content="Browse..." Margin="6,0,0,0" Padding="12,0"
                                Click="BrowseOneDrive_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtOneDriveStatus" Text="Status: Checking..." FontSize="10"
                               Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"
                               Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource Tint10}" BorderBrush="{DynamicResource Tint15}" BorderThickness="0.5" CornerRadius="8" Padding="10,8">
                        <TextBlock Text="Files are stored in OneDrive\VideoConverter and automatically synchronized by Windows to your Microsoft cloud account."
                                   FontSize="9.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- WEBHOOK PANEL -->
                <StackPanel x:Name="PanelWebhook" Visibility="Collapsed">
                    <TextBlock Text="Discord / Custom Webhook URL" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtWebhookUrl" Height="30" FontSize="11"
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 Tag="https://discord.com/api/webhooks/..."/>
                        <Button Grid.Column="1" Style="{StaticResource OutlineBtn}" Height="30"
                                Content="Test Webhook" Margin="8,0,0,0" Padding="12,0"
                                Click="TestWebhook_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtWebhookStatus" Text="Status: Enter a Discord Webhook URL" FontSize="10"
                               Foreground="{DynamicResource TextSec}" Margin="2,0,0,8"/>
                    <Border Background="{DynamicResource Tint10}" BorderBrush="{DynamicResource Tint15}" BorderThickness="0.5" CornerRadius="8" Padding="10,8">
                        <TextBlock Text="In Discord, right-click any channel → Edit Channel → Integrations → Webhooks → Copy Webhook URL. VideoConverter will upload videos directly to your Discord channel!"
                                   FontSize="9.5" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══ Footer Action Buttons ═══ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkCloudTempOnly" Content="Download temporary &amp; upload to destination"
                              Style="{StaticResource GlassToggleSwitchLabeled}"
                              VerticalAlignment="Center" ToolTip="{DynamicResource LblTempDownloadHint}" Width="277" FontSize="11" Template="{DynamicResource GlassCapsuleToggleTemplate}" Height="32"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource OutlineBtn}" Content="Cancel"
                        Height="30" Padding="14,0" Margin="0,0,8,0" Click="Close_Click"/>

                <Button Grid.Column="2" Style="{StaticResource GradRectBtn}" Content="Save &amp; Apply"
                        Height="30" Padding="16,0" Click="Save_Click"/>
            </Grid>
        </Grid>
    </helpers:SquircleBorder>
</Window>
