<Application x:Class="VideoConverterUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:anim="clr-namespace:VideoConverterUI.Animations"
             xmlns:controls="clr-namespace:VideoConverterUI.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Theme/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
                <ResourceDictionary Source="Assets/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════ Color Palette ══════ -->
            <SolidColorBrush x:Key="BgDeep"      Color="#FF1C1C1E"/>
            <SolidColorBrush x:Key="BgSurface"   Color="#C8232325"/>
            <SolidColorBrush x:Key="BgCard"       Color="#C82C2C2E"/>
            <SolidColorBrush x:Key="BgElevated"   Color="#DF3A3A3C"/>
            <SolidColorBrush x:Key="BorderSub"    Color="#38383A"/>
            <SolidColorBrush x:Key="Accent"       Color="#0A84FF"/>
            <SolidColorBrush x:Key="AccentPink"   Color="#64D2FF"/>
            <SolidColorBrush x:Key="TextPrimary"  Color="#F5F5F7"/>
            <SolidColorBrush x:Key="TextSec"      Color="#98989D"/>
            <SolidColorBrush x:Key="SuccessGreen" Color="#30D158"/>
            <SolidColorBrush x:Key="ErrorRed"     Color="#FF453A"/>

            <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#3A3A3C" Offset="0"/>
                <GradientStop Color="#3A3A3C" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeaderGrad" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1B1B1E" Offset="0"/>
                <GradientStop Color="#22222A" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BgGrad" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#141416" Offset="0"/>
                <GradientStop Color="#1E1E24" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ThumbGrad" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#550A84FF" Offset="0"/>
                <GradientStop Color="#150A84FF" Offset="1"/>
            </LinearGradientBrush>

            <!-- Mode-dependent values; ThemeService.ApplyModeResources overwrites these (plus Tint01..Tint80) -->
            <sys:Double x:Key="TextShadowOpacity">0.5</sys:Double>
            <SolidColorBrush x:Key="ConsoleText" Color="#E5E5EA"/>
            <SolidColorBrush x:Key="TextOnMedia" Color="#FFFFFF"/>

            <sys:Double x:Key="GlobalScrollBarWidth">6</sys:Double>
            <sys:Double x:Key="GlobalScrollBarHeight">6</sys:Double>

            <!-- ══════ Switches (CheckBox): glisse's switch, Controls/GlassSwitch ══════ -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <controls:GlassSwitch x:Name="Switch" IsOn="{TemplateBinding IsChecked}" IsHeld="{TemplateBinding IsPressed}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Switch" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A little smaller, for the tight rows of the Multi Downloader's options -->
            <Style x:Key="SubtleToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <controls:GlassSwitch x:Name="Switch" Scale="0.3" IsOn="{TemplateBinding IsChecked}" IsHeld="{TemplateBinding IsPressed}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Switch" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Switch + text, the text greyed out while off -->
            <ControlTemplate x:Key="GlassToggleTemplate" TargetType="CheckBox">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <controls:GlassSwitch x:Name="Switch" IsOn="{TemplateBinding IsChecked}" IsHeld="{TemplateBinding IsPressed}"/>
                    <ContentPresenter x:Name="Label" Margin="6,0,0,0" VerticalAlignment="Center"
                                      RecognizesAccessKey="True" Opacity="0.4"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Switch" Property="Opacity" Value="0.35"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="GlassToggleSwitch" TargetType="CheckBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource GlassToggleTemplate}"/>
            </Style>

            <Style x:Key="GlassToggleSwitchLabeled" TargetType="CheckBox" BasedOn="{StaticResource GlassToggleSwitch}">
                <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- The same with the text on the left -->
            <ControlTemplate x:Key="GlassToggleTemplateLeftLabel" TargetType="CheckBox">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <ContentPresenter x:Name="Label" Margin="0,0,6,0" VerticalAlignment="Center"
                                      RecognizesAccessKey="True" Opacity="0.4"/>
                    <controls:GlassSwitch x:Name="Switch" IsOn="{TemplateBinding IsChecked}" IsHeld="{TemplateBinding IsPressed}"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Switch" Property="Opacity" Value="0.35"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="GlassToggleSwitchLabeledLeft" TargetType="CheckBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template" Value="{StaticResource GlassToggleTemplateLeftLabel}"/>
            </Style>

            <!-- ══════ ScrollBar ══════ -->
            <!-- Slim overlay-style bar: a thin translucent pill, no track and no arrows. It widens a little under the mouse,
                 and ScrollBarAutoHide fades it in while scrolling or hovering and out again afterwards. -->
            <ControlTemplate x:Key="SlimScrollThumbV" TargetType="Thumb">
                <Grid Background="Transparent">
                    <Border x:Name="Pill" Width="2.5" CornerRadius="3" HorizontalAlignment="Center" Margin="0,3"
                            Background="{DynamicResource TextPrimary}" Opacity="0.28"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Pill" Property="Opacity" Value="0.45"/>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Width" To="5" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Width" To="2.5" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="Pill" Property="Opacity" Value="0.6"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="SlimScrollThumbH" TargetType="Thumb">
                <Grid Background="Transparent">
                    <Border x:Name="Pill" Height="2.5" CornerRadius="3" VerticalAlignment="Center" Margin="3,0"
                            Background="{DynamicResource TextPrimary}" Opacity="0.28"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Pill" Property="Opacity" Value="0.45"/>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height" To="5" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height" To="2.5" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="Pill" Property="Opacity" Value="0.6"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="ScrollBar">
                <Setter Property="anim:ScrollBarAutoHide.IsEnabled" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="{DynamicResource GlobalScrollBarWidth}"/>
                <Setter Property="MinWidth" Value="{DynamicResource GlobalScrollBarWidth}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Template="{StaticResource SlimScrollThumbV}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="{DynamicResource GlobalScrollBarHeight}"/>
                        <Setter Property="MinHeight" Value="{DynamicResource GlobalScrollBarHeight}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track">
                                            <Track.Thumb>
                                                <Thumb Template="{StaticResource SlimScrollThumbH}"/>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ══════ Global TextBox (glass) ══════ -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource InputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource TextSec}" Opacity="0.6"
                                               FontSize="{TemplateBinding FontSize}"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Global PasswordBox (glass) ══════ -->
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource InputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Glass Pill TextBox (URL Input) ══════ -->

            <!-- ══════ ComboBox Toggle Button (macOS pop-up button) ══════ -->
            <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
                <Border x:Name="Bd" CornerRadius="15"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ui:SymbolIcon x:Name="ArrowIcon" Symbol="ChevronUpDown16" FontSize="12"
                                   Foreground="{DynamicResource TextSec}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,10,0" IsHitTestVisible="False"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                        <Setter TargetName="ArrowIcon" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBg}"/>
                        <Setter TargetName="ArrowIcon" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- ══════ Dropdown Menu Surface (shared by every ComboBox popup) ══════
                 The margin leaves room for the shadow inside the popup window; DropdownAnimBehavior
                 accounts for it when it lines the selected item up over the box. The menu itself is a
                 LiquidGlassPanel (surface "Dropdown", in a GlassShadow) inside this border, which only keeps its place
                 (driven by the panel's tuning) and the open animation. -->
            <Style x:Key="ComboMenuSurface" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Selected value in the closed box: one line, ellipsis instead of running under the chevron -->
            <Style x:Key="ComboSelectionText" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- ══════ Global ComboBox ══════ -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource InputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="27.5"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="MaxDropDownHeight" Value="320"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="anim:DropdownAnimBehavior.IsEnabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                                <ToggleButton x:Name="ToggleButton"
                                              Style="{x:Null}"
                                              Template="{StaticResource ComboToggle}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False" ClickMode="Press"/>
                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="12,0,26,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ComboSelectionText}"/>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="None" Placement="Bottom">
                                    <!-- Host keeps the popup window still while the surface scales in -->
                                    <Grid x:Name="PopupHost">
                                        <Border Style="{StaticResource ComboMenuSurface}"
                                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <controls:GlassShadow>
                                            <controls:LiquidGlassPanel Surface="Dropdown">
                                                <controls:UnclippedDecorator Margin="5">
                                                <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel IsItemsHost="True"
                                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                </ScrollViewer>
                                                </controls:UnclippedDecorator>
                                            </controls:LiquidGlassPanel>
                                            </controls:GlassShadow>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Global ComboBoxItem (macOS menu row) ══════
                 Checkmark gutter marks the chosen value; only the row under the pointer/keyboard
                 gets the accent fill, so there is never more than one highlighted row. -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Padding" Value="5,4,12,4"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Check" Width="10" Height="10" Stretch="Uniform"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Data="M1,5.2 L4.2,8.4 L9.5,1.4"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Hidden"/>
                                    <ContentPresenter x:Name="ItemContent" Grid.Column="1"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource TextOnMedia}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnMedia}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Global ContextMenu / MenuItem (Liquid Glass, like the drop-downs) ══════
                 Same surface as a ComboBox popup: a border (ComboMenuSurface, whose 14 px margin the
                 offsets below cancel so the menu still opens at the pointer) around a LiquidGlassPanel "Dropdown".
                 Rows match ComboBoxItem: check gutter, accent fill on the highlighted row only. Submenus open in the
                 same glass beside their row. Open animation: MenuAnimBehavior. -->
            <Style TargetType="ContextMenu">
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalOffset" Value="-12"/>
                <Setter Property="VerticalOffset" Value="-12"/>
                <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                <Setter Property="anim:MenuAnimBehavior.IsEnabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <!-- Host keeps the popup window still while the surface scales in -->
                            <Grid>
                                <Border x:Name="MenuSurface" Style="{StaticResource ComboMenuSurface}" MinWidth="180">
                                    <controls:GlassShadow>
                                    <controls:LiquidGlassPanel Surface="Dropdown">
                                        <StackPanel Margin="5" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </controls:LiquidGlassPanel>
                                    </controls:GlassShadow>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="10,4" Background="{DynamicResource Tint14}" SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="5,4,10,4"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="anim:MenuAnimBehavior.IsEnabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconHost" ContentSource="Icon" Width="14" Height="14"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Path x:Name="Check" Width="10" Height="10" Stretch="Uniform"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Data="M1,5.2 L4.2,8.4 L9.5,1.4"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Hidden"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="18,0,0,0"
                                               Opacity="0.6" VerticalAlignment="Center"/>
                                    <Path x:Name="Chevron" Grid.Column="3" Width="5" Height="9" Stretch="Uniform" Margin="14,0,2,0"
                                          VerticalAlignment="Center" Data="M0,0 L4,4.5 L0,9"
                                          Stroke="{DynamicResource TextSec}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Collapsed"/>

                                    <!-- Submenu: beside the row, its first item level with it (offsets cancel the shadow margin
                                         and the glass's inner padding) -->
                                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-7" VerticalOffset="-19"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                        <Grid>
                                            <Border x:Name="SubMenuSurface" Style="{StaticResource ComboMenuSurface}" MinWidth="170">
                                                <controls:GlassShadow>
                                                <controls:LiquidGlassPanel Surface="Dropdown">
                                                    <StackPanel Margin="5" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"
                                                                Grid.IsSharedSizeScope="True"/>
                                                </controls:LiquidGlassPanel>
                                                </controls:GlassShadow>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint14}"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource TextOnMedia}"/>
                                    <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextOnMedia}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnMedia}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Global CheckBox (Apple ToggleSwitch) ══════ -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}"/>

            <!-- ══════ glisse's buttons (Controls/GlassChrome, Animations/GlassPress): Glass, Filled, Tinted, Tinted filled,
                 Destructive, Destructive filled. A capsule whatever its height; Background set = filled. ══════ -->
            <Style x:Key="GlassBtn" TargetType="ButtonBase">
                <Setter Property="anim:GlassPress.IsEnabled" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{x:Null}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <controls:GlassChrome x:Name="Chrome" Fill="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                                  IsHovered="{TemplateBinding IsMouseOver}" IsHeld="{TemplateBinding IsPressed}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </controls:GlassChrome>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FilledBtn" TargetType="ButtonBase" BasedOn="{StaticResource GlassBtn}">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnMedia}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="TintedBtn" TargetType="ButtonBase" BasedOn="{StaticResource GlassBtn}">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Style>
            <Style x:Key="DestructiveBtn" TargetType="ButtonBase" BasedOn="{StaticResource GlassBtn}">
                <Setter Property="Foreground" Value="{DynamicResource ErrorRed}"/>
            </Style>
            <Style x:Key="DestructiveFilledBtn" TargetType="ButtonBase" BasedOn="{StaticResource FilledBtn}">
                <Setter Property="Background" Value="{DynamicResource ErrorRed}"/>
            </Style>
            <!-- A round icon button: glisse's Button with only an icon -->
            <Style x:Key="GlassIconBtn" TargetType="ButtonBase" BasedOn="{StaticResource GlassBtn}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <!-- ══════ glisse's Input: a capsule text box, brighter while focused ══════ -->
            <Style x:Key="GlassInput" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <controls:GlassChrome x:Name="Chrome" Padding="{TemplateBinding Padding}"
                                                  IsHovered="{TemplateBinding IsMouseOver}" IsHeld="{TemplateBinding IsKeyboardFocusWithin}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextSec}" Opacity="0.75"
                                               FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" IsHitTestVisible="False"
                                               TextTrimming="CharacterEllipsis" Margin="2,0,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </controls:GlassChrome>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ glisse's search field: no surface of its own (it lies on a Liquid Glass capsule), a glyph before the text
                 (controls:GlassField.Icon), a clear button once there is text, and the glass brightens while focused ══════ -->
            <Style x:Key="GlassSearchField" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Padding" Value="14,0,6,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="Transparent">
                                <Border x:Name="Lit" CornerRadius="30" Background="{DynamicResource Tint0A}" Opacity="0" IsHitTestVisible="False"/>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon x:Name="Glyph" Symbol="{Binding (controls:GlassField.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="15" Foreground="{DynamicResource TextSec}" Margin="0,0,9,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextSec}"
                                               FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" IsHitTestVisible="False"
                                               TextTrimming="CharacterEllipsis" Margin="2,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="Clear" Grid.Column="2" controls:GlassField.ClearButton="True" Focusable="False" IsTabStop="False"
                                            Width="24" Height="24" Margin="4,0,0,0" Cursor="Hand" ToolTip="{DynamicResource TipClearField}" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="Bd" Fill="{DynamicResource Tint1F}" Opacity="0"/>
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{DynamicResource TextSec}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="1"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Clear" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Clear" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Lit" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Clear" Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Flat Icon Button ══════ -->
            <Style x:Key="IconBtn" TargetType="Button">
                <Setter Property="anim:MicroAnimationBehavior.IsEnabled" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Embedded Capsule Button (Inside Input Pill) ══════ -->
            <Style x:Key="EmbeddedCapsuleBtn" TargetType="Button">
                <Setter Property="anim:MicroAnimationBehavior.IsEnabled" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="2,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="20" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Glass Icon Button (liquid glass) ══════ -->

            <!-- ══════ Outlined Button ══════ -->
            <Style x:Key="OutlineBtn" TargetType="Button" BasedOn="{StaticResource GlassBtn}">
                <Setter Property="Height" Value="NaN"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <!-- ══════ Glass Pill Button (Log) ══════ -->
            <Style x:Key="GlassPillBtn" TargetType="Button" BasedOn="{StaticResource GlassBtn}">
                <Setter Property="Height" Value="NaN"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,0"/>
            </Style>

            <!-- ══════ Header Language Pill Button (sits on the main window's glass capsule LangPillGlass) ══════ -->
            <Style x:Key="HeaderLangPillBtn" TargetType="Button">
                <Setter Property="anim:MicroAnimationBehavior.IsEnabled" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="17" Padding="12,0" Height="34"
                                    Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Card Border Style (glass) ══════ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource InputBg}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- ══════ Section Label ══════ -->
            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- ══════ Start Button (glass) ══════ -->

            <!-- ══════ Action Button (liquid glass, rounded rect) ══════ -->
            <Style x:Key="GradRectBtn" TargetType="Button">
                <Setter Property="anim:MicroAnimationBehavior.IsEnabled" Value="True"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" Padding="12,0"
                                    BorderThickness="0.5"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                <DynamicResource ResourceKey="Tint2D"/>
                            </Border.Background>
                                <Border.BorderBrush>
                                <DynamicResource ResourceKey="Tint38"/>
                            </Border.BorderBrush>
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Idle State -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                        <Condition Property="IsPressed" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiTrigger.EnterActions>
                                </MultiTrigger>
                                <!-- Hover State -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsPressed" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint3E}"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="White" BlurRadius="12" Opacity="0.18" ShadowDepth="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.03" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.03" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiTrigger.EnterActions>
                                </MultiTrigger>
                                <!-- Pressed State -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint50}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.96" Duration="0:0:0.1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.96" Duration="0:0:0.1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Primary Action Button (alias to GradRectBtn) ══════ -->

            <!-- ══════ Tab Header Button ══════ -->

            <!-- ══════ Mode Card Toggle ══════ -->

            <!-- ══════ iOS 26 Segmented Control Button ══════ -->
            <Style x:Key="SegmentedBtn" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="35" Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    BorderThickness="0" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Segment Pill RadioButton (self-contained tab button) ══════ -->
            <Style x:Key="SegmentPill" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCard}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════ Slider (implicit): glisse's slider, see Controls/GlassSlider ══════ -->
            <Style TargetType="Slider">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                <Setter Property="Background" Value="{x:Null}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <controls:GlassSlider x:Name="Visual" RailBrush="{TemplateBinding Background}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Visual" Property="Opacity" Value="0.35"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

<!-- ═══ Collapsible card: the one expandable section used everywhere ═══ -->
            <Style TargetType="{x:Type controls:CollapsibleCard}">
                <Setter Property="Background" Value="{DynamicResource InputBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSub}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:CollapsibleCard}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <ToggleButton x:Name="PART_Header" Style="{x:Null}" Focusable="False" Cursor="Hand"
                                                  Padding="{TemplateBinding Padding}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentMarker" Width="4" Height="20" CornerRadius="2" Margin="0,0,10,0"
                                                    VerticalAlignment="Center" Background="{TemplateBinding AccentBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"
                                                                  TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold"
                                                                  TextElement.Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSec}" Opacity="0.85" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock x:Name="SummaryText" Text="{TemplateBinding Summary}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Border x:Name="ChevronCircle" Width="24" Height="24" CornerRadius="12" Background="Transparent">
                                                    <ui:SymbolIcon x:Name="PART_Chevron" Symbol="ChevronDown24" FontSize="12"
                                                                   Foreground="{DynamicResource TextSec}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   RenderTransformOrigin="0.5,0.5"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </ToggleButton>
                                    <controls:ExpandPresenter x:Name="PART_Body">
                                        <StackPanel>
                                            <Border Height="0.5" Background="{TemplateBinding BorderBrush}"/>
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </StackPanel>
                                    </controls:ExpandPresenter>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="AccentBrush" Value="{x:Null}">
                                    <Setter TargetName="AccentMarker" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Description" Value="{x:Null}">
                                    <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Description" Value="">
                                    <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Summary" Value="{x:Null}">
                                    <Setter TargetName="SummaryText" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Summary" Value="">
                                    <Setter TargetName="SummaryText" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger SourceName="PART_Header" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChevronCircle" Property="Background" Value="{DynamicResource HoverBg}"/>
                                    <Setter TargetName="PART_Chevron" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
