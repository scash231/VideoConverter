<Window x:Class="VideoConverterUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:VideoConverterUI.Animations"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        xmlns:helpers="clr-namespace:VideoConverterUI.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="VideoConverter" Width="760" Height="570"
        MinWidth="600" MinHeight="520"
        Icon="Icons/app.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        SizeChanged="Window_SizeChanged"
        PreviewDragEnter="Window_DragEnter"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop">

    <!-- ═══════════════════ WINDOW RESOURCES ═══════════════════ -->
    <Window.Resources>
        <Storyboard x:Key="FadeInWindow">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.88" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.85" To="1" Duration="0:0:0.52"
                             BeginTime="0:0:0.035">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Minimal Integrated Log Text Button (Light Liquid Glass Sheen) -->
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInWindow}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- ═══════════════════ ROOT BORDER ═══════════════════ -->
    <helpers:SquircleBorder x:Name="RootBorder" CornerRadius="20"
            Background="{DynamicResource BgGrad}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
            Opacity="100" RenderTransformOrigin="0.5,0.5">
        <helpers:SquircleBorder.RenderTransform>
            <ScaleTransform x:Name="WindowScale"/>
        </helpers:SquircleBorder.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!-- Title bar -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="Auto"/>
                <!-- Dev Console -->
            </Grid.RowDefinitions>

            <!-- ═══════════ FALLING SNOW OVERLAY (ROOT BACKGROUND) ═══════════ -->
            <Canvas x:Name="SnowCanvas" Grid.RowSpan="3" IsHitTestVisible="False" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" Panel.ZIndex="-1000"/>

            <!-- ═══════════ SPIDER & COBWEB OVERLAY (ROOT OVERLAY) ═══════════ -->
            <Canvas x:Name="SpiderOverlayCanvas" Grid.RowSpan="3" IsHitTestVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" Panel.ZIndex="995">
                <TextBlock x:Name="TxtAppTitleVideo" FontWeight="SemiBold"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                   Cursor="Hand" Background="Transparent"
                                   MouseLeftButtonDown="TitleStack_Click" HorizontalAlignment="Left" Canvas.Left="15" Canvas.Top="12" VerticalAlignment="Center"><Run Text="V"/><LineBreak/><Run/></TextBlock>
                <TextBlock x:Name="TxtAppTitleRest" FontWeight="SemiBold"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}" Canvas.Left="23" Canvas.Top="12" HorizontalAlignment="Left" VerticalAlignment="Center"><Run Language="de-de" Text="ideo"/><Run Text="Converter"/></TextBlock>
            </Canvas>

            <!-- ═══════════ PARTY DISCO GLOBE OVERLAY (DEEP BACKGROUND & ACCURATE RAYS) ═══════════ -->
            <Canvas x:Name="DiscoBallContainer" Grid.RowSpan="3" IsHitTestVisible="False" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Width="1000" Height="1000"
                    Margin="0,-120,0,0" Panel.ZIndex="-999">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="DiscoBallLowerTransform" Y="0"/>
                </Canvas.RenderTransform>
                <Canvas.Resources>
                    <!-- Disco Light Rays Rotation -->
                    <Storyboard x:Key="DiscoRaysRotate" RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="DiscoRaysTransform" Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:6"/>
                    </Storyboard>
                    <!-- Disco Ball & Rays Glint Pulse -->
                    <Storyboard x:Key="DiscoGlint" RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="DiscoGlintGlow" Storyboard.TargetProperty="Opacity"
                                         From="0.3" To="0.95" Duration="0:0:0.8"/>
                        <DoubleAnimation Storyboard.TargetName="DiscoRaysGlow" Storyboard.TargetProperty="BlurRadius"
                                         From="20" To="45" Duration="0:0:1.2"/>
                    </Storyboard>
                </Canvas.Resources>

                <Grid Width="1000" Height="1000">
                    <!-- Rotating Light Beams Centered EXCLUSIVELY at (500, 145) -->
                    <Grid x:Name="DiscoRays" Width="1000" Height="1000" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid.Effect>
                            <DropShadowEffect x:Name="DiscoRaysGlow" BlurRadius="30" Color="#00F0FF" Opacity="0.9" ShadowDepth="0"/>
                        </Grid.Effect>
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="DiscoRaysTransform" CenterX="500" CenterY="145"/>
                        </Grid.RenderTransform>
                        <!-- Ray Paths Radiating Directly From (500, 145) Outward -->
                        <Path Data="M 500,145 L -200,-300 L 0,-400 Z" Fill="#50FF007F"/>
                        <Path Data="M 500,145 L 1000,-400 L 1200,-300 Z" Fill="#5000F0FF"/>
                        <Path Data="M 500,145 L 1200,800 L 1000,1000 Z" Fill="#50FFD700"/>
                        <Path Data="M 500,145 L 0,1000 L -200,800 Z" Fill="#5039FF14"/>
                        <Path Data="M 500,145 L 430,-400 L 570,-400 Z" Fill="#50BF5AF2"/>
                        <Path Data="M 500,145 L 1200,380 L 1200,520 Z" Fill="#50FF9500"/>
                        <Path Data="M 500,145 L -200,380 L -200,520 Z" Fill="#50FF0055"/>
                        <Path Data="M 500,145 L 430,1200 L 570,1200 Z" Fill="#5000E5FF"/>
                    </Grid>

                    <!-- Metallic Wire/Chain hanging down to Y=110 -->
                    <Rectangle Width="2" Height="110" Fill="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <!-- Disco Sphere centered at Y=145 (70x70 sphere with top at Y=110) -->
                    <Grid Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,110,0,0">
                        <Ellipse Width="74" Height="74" Margin="-2">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="DiscoGlintGlow" BlurRadius="22" Color="#E0F7FA" Opacity="0.7" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Ellipse Width="70" Height="70">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.35,0.35" RadiusX="0.65" RadiusY="0.65">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#B0BEC5" Offset="0.4"/>
                                    <GradientStop Color="#37474F" Offset="0.95"/>
                                    <GradientStop Color="#1A237E" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Facet Grid -->
                        <Border Width="68" Height="68" CornerRadius="35" ClipToBounds="True">
                            <Canvas Opacity="0.55">
                                <Line X1="0" Y1="12" X2="70" Y2="12" Stroke="#FFFFFF" StrokeThickness="0.6"/>
                                <Line X1="0" Y1="24" X2="70" Y2="24" Stroke="#FFFFFF" StrokeThickness="0.6"/>
                                <Line X1="0" Y1="36" X2="70" Y2="36" Stroke="#FFFFFF" StrokeThickness="0.6"/>
                                <Line X1="0" Y1="48" X2="70" Y2="48" Stroke="#FFFFFF" StrokeThickness="0.6"/>
                                <Line X1="0" Y1="60" X2="70" Y2="60" Stroke="#FFFFFF" StrokeThickness="0.6"/>

                                <Line X1="14" Y1="0" X2="14" Y2="70" Stroke="#FFFFFF" StrokeThickness="0.6"/>
                                <Line X1="28" Y1="0" X2="28" Y2="70" Stroke="#FFFFFF" StrokeThickness="0.6"/>
                                <Line X1="42" Y1="0" X2="42" Y2="70" Stroke="#FFFFFF" StrokeThickness="0.6"/>
                                <Line X1="56" Y1="0" X2="56" Y2="70" Stroke="#FFFFFF" StrokeThickness="0.6"/>
                            </Canvas>
                        </Border>

                        <Ellipse Width="18" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Grid>
            </Canvas>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="Transparent"
                    CornerRadius="16,16,0,0" Panel.ZIndex="10"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title & Version (Column 0, Fixed Position) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"/>

                    <!-- Middle: Liquid Glass Progress Bar + Header Action Pills (Column 1, Constrained between Title & Controls) -->
                    <Grid Grid.Column="1" Margin="12,0,8,0" ClipToBounds="True">
                        <!-- Liquid Glass Miniature Progress Bar -->
                        <Border x:Name="MiniProgressContainer"
                                Height="8" CornerRadius="4.5"
                                HorizontalAlignment="Left" Width="140"
                                Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource BorderSub}"
                                BorderThickness="0.5"
                                VerticalAlignment="Center"
                                Cursor="Hand" Visibility="Hidden"
                                MouseLeftButtonDown="MiniProgress_Click"
                               
                                ToolTip="{DynamicResource MiniProgressTip}" Margin="85,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect x:Name="MiniProgressGlow" BlurRadius="4" ShadowDepth="0" Color="#FFFFFF" Opacity="0.15"/>
                            </Border.Effect>
                            <Border.Resources>
                                <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="MiniProgressGlow"
                                                     Storyboard.TargetProperty="BlurRadius"
                                                     From="2" To="8" Duration="0:0:1.2"/>
                                    <DoubleAnimation Storyboard.TargetName="MiniProgressGlow"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.1" To="0.35" Duration="0:0:1.2"/>
                                </Storyboard>
                            </Border.Resources>
                            <Grid Margin="152,6,-152,-6">
                                <!-- Inner Glass Track Depth Groove -->
                                <Border CornerRadius="4" Background="#15000000" Margin="95,0,-95,0"/>

                                <!-- Liquid Glass Grey Fill Bar -->
                                <Border x:Name="MiniProgressFill" Height="9" CornerRadius="4"
                                        Width="0" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#4A4E5A" Offset="0"/>
                                            <GradientStop Color="#6E7485" Offset="0.5"/>
                                            <GradientStop Color="#5A5F6E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <!-- Glass Specular Top Gloss Highlight -->
                                        <Border Height="4.5" VerticalAlignment="Top" CornerRadius="4,4,0,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#55FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- Inner Subtle Sheen Overlay -->
                                        <Border Height="1" VerticalAlignment="Bottom" Margin="1,0,1,1" CornerRadius="0,0,3,3" Background="{DynamicResource Tint20}"/>
                                    </Grid>
                                </Border>

                                <!-- Capsule Glass Refraction Sheen Overlay for Entire Container -->
                                <Border CornerRadius="4.5" IsHitTestVisible="False" HorizontalAlignment="Left" Width="137" Margin="-151,-7,0,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#0DFFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right Aligned Pills -->
                        <StackPanel x:Name="HeaderActionStack" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Realtime Performance Overlay Bubble -->
                            <Border x:Name="BorderPerformanceOverlay"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource BorderSub}"
                                    BorderThickness="0.5" CornerRadius="8"
                                    Height="30.1" Padding="8,0" Margin="0,0,4,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPerfCpu" Text="CPU: 0%" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSec}" Margin="0,0,6,0"/>
                                    <TextBlock Text="|" FontSize="9" Foreground="{DynamicResource BorderSub}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPerfRam" Text="RAM: 0 MB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSec}" Margin="0,0,6,0"/>
                                    <TextBlock Text="|" FontSize="9" Foreground="{DynamicResource BorderSub}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPerfFps" Text="Render: 1.2ms" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSec}"/>
                                </StackPanel>
                            </Border>

                            <!-- Pill 1: ! and ? -->
                            <Border x:Name="PillHelpGroup"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource BorderSub}"
                                    BorderThickness="0.5" CornerRadius="8"
                                    Padding="4.7,0" Margin="0,0,4,0"
                                    VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PillHelpTranslate" X="0" Y="0"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Error Status Button + divider (collapsed as a group) -->
                                    <Button x:Name="BtnErrorStatus"
                                            Style="{StaticResource IconBtn}"
                                            Foreground="{DynamicResource ErrorRed}"
                                            MinWidth="30.1" MinHeight="30.1" Height="30.1" Margin="0" Padding="6,0"
                                            ToolTip="Error Details"
                                            Visibility="Collapsed"
                                            Click="ErrorStatus_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="{DynamicResource ErrorRed}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtErrorStatusLabel" Text="Error" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Divider after ! (collapsed with it) -->
                                    <Border x:Name="ErrorPillDivider"
                                            Width="1" Height="11.5"
                                            Background="{DynamicResource BorderSub}"
                                            Margin="2,0" Visibility="Collapsed"
                                            VerticalAlignment="Center"/>
                                    <!-- Help / Workflow -->
                                    <Button x:Name="BtnHelp"
                                            Style="{StaticResource IconBtn}"
                                            Foreground="{DynamicResource TextSec}"
                                            MinWidth="30.1" MinHeight="30.1" Height="30.1" Margin="0" Padding="6,0"
                                            ToolTip="{DynamicResource HelpTip}"
                                            Click="Help_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Info28" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtHelpLabel" Text="{DynamicResource HelpLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Pill 2: Console & Log Group Bubble -->
                            <Border x:Name="DevPillGroup"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource BorderSub}"
                                    BorderThickness="0.5" CornerRadius="8"
                                    Padding="4.7,0" Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Console Button -->
                                    <Button x:Name="BtnHeaderConsole"
                                            Style="{StaticResource IconBtn}"
                                            Foreground="{DynamicResource TextSec}"
                                            MinWidth="30.1" MinHeight="30.1" Height="30.1" Margin="0" Padding="6,0"
                                            ToolTip="Console"
                                            Visibility="Collapsed"
                                            Click="HeaderConsole_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Code24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtHeaderConsoleLabel" Text="Console" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Divider between Console & Log -->
                                    <Border x:Name="HeaderDevDivider"
                                            Width="1" Height="11.5"
                                            Background="{DynamicResource BorderSub}"
                                            Margin="2,0" Visibility="Collapsed"
                                            VerticalAlignment="Center"/>
                                    <!-- Log Button -->
                                    <Button x:Name="BtnHeaderLog"
                                            Style="{StaticResource IconBtn}"
                                            Foreground="{DynamicResource TextSec}"
                                            MinWidth="30.1" MinHeight="30.1" Height="30.1" Margin="0" Padding="6,0"
                                            ToolTip="Log Viewer"
                                            Visibility="Collapsed"
                                            Click="HeaderLog_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtHeaderLogLabel" Text="Log" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Pill 3: ✂, ⚙ (Collapsible into •••) -->
                            <Border x:Name="PillToolsGroup"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource BorderSub}"
                                    BorderThickness="0.5" CornerRadius="8"
                                    Padding="4.7,0" Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <!-- Expanded Mode: ✂ | ⚙ -->
                                    <StackPanel x:Name="StackToolsExpanded" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Video Editor -->
                                        <Button x:Name="BtnVideoEditor" Style="{StaticResource IconBtn}"
                                                Foreground="{DynamicResource TextSec}"
                                                MinWidth="30.1" MinHeight="30.1" Height="30.1" Margin="0" Padding="6,0"
                                                ToolTip="{DynamicResource TipEditor}"
                                                Click="Editor_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Cut24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtToolEditor" Text="Editor" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Button>
                                        <Border x:Name="VideoEditorSep" Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="2,0" VerticalAlignment="Center"/>
                                        <!-- Batch & Playlist Queue -->
                                        <Button x:Name="BtnBatchQueue" Style="{StaticResource IconBtn}"
                                                Foreground="{DynamicResource TextSec}"
                                                MinWidth="30.1" MinHeight="30.1" Height="30.1" Margin="0" Padding="6,0"
                                                ToolTip="{DynamicResource TipBatchQueue}"
                                                Click="BatchQueue_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Collections24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtToolBatchQueue" Text="Batch" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Button>
                                        <Border x:Name="BatchQueueSep" Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="2,0" VerticalAlignment="Center"/>
                                        <!-- Settings -->
                                        <Button x:Name="BtnSettings" Style="{StaticResource IconBtn}"
                                                Foreground="{DynamicResource TextSec}"
                                                MinWidth="30.1" MinHeight="30.1" Height="30.1" Margin="0" Padding="6,0"
                                                ToolTip="{DynamicResource TipSettings}"
                                                Click="Settings_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Settings24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtToolSettings" Text="Settings" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Collapsed Mode: ••• -->
                                    <Button x:Name="BtnToolsCollapsed" Style="{StaticResource IconBtn}"
                                             Foreground="{DynamicResource TextSec}"
                                             Width="30.1" Height="30.1" Margin="0"
                                             ToolTip="{DynamicResource TipToolsAndSettings}"
                                             Visibility="Collapsed"
                                             Click="ToolsCollapsed_Click">
                                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Collapsed Tools Popup Menu -->
                            <Popup x:Name="PopupToolsMenu"
                                    Placement="Bottom"
                                    VerticalOffset="4"
                                    StaysOpen="False"
                                    AllowsTransparency="True"
                                    PopupAnimation="None">
                                <Border x:Name="ToolsPopupBorder" controls:LiquidGlass.Surface="Popup"
                                         Background="{DynamicResource PopupBg}"
                                         BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
                                         anim:FluidMotion.CornerRadiusValue="55"
                                         Padding="8,6" MinWidth="160"
                                         Opacity="0" RenderTransformOrigin="0.5,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="2" Color="#000000" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                            <TranslateTransform Y="-4"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Button Style="{StaticResource GlassPillBtn}" Height="28" Margin="0,0,0,3" Click="EditorFromMenu_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="VideoClip24" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource EditorTitle}" FontSize="11" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GlassPillBtn}" Height="28" Margin="0,0,0,3" Click="BatchQueueFromMenu_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Collections24" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource BatchQueueTitle}" FontSize="11" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GlassPillBtn}" Height="28" Click="SettingsFromMenu_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Settings24" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="11" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Language Toggle Pill Button -->
                            <Button x:Name="BtnLangPill" VerticalAlignment="Center" Margin="0,0,6,0"
                                    Click="LangPill_Click" Style="{StaticResource HeaderLangPillBtn}"
                                    ToolTip="{DynamicResource SettingsLanguage}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCurrentLang" Text="EN"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <Border Width="1" Height="11.5" Background="{DynamicResource BorderSub}" Margin="6,0" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon x:Name="IconLangArrow" Symbol="ChevronRight24" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Fixed Window Controls: Minimize & Close (Column 2, Strictly fixed right position) -->
                    <StackPanel x:Name="WindowControlsStack" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}"
                                Foreground="{DynamicResource TextSec}" Width="35" Height="35"
                                ToolTip="{DynamicResource TipMinimize}"
                                Click="Minimize_Click">
                            <ui:SymbolIcon Symbol="Subtract24" FontSize="13" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}"
                                Foreground="{DynamicResource AccentGrad}" Width="35" Height="35"
                                ToolTip="{DynamicResource TipClose}"
                                Click="Close_Click">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <Popup x:Name="HelpPopup"
                           Placement="Bottom"
                           VerticalOffset="4"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           PopupAnimation="None"
                           Closed="HelpPopup_Closed">
                        <Border x:Name="HelpPopupBorder" controls:LiquidGlass.Surface="Popup"
                                Background="{DynamicResource PopupBg}"
                                BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
                                anim:FluidMotion.CornerRadiusValue="55"
                                Padding="16,14,16,12" Width="296"
                                Opacity="0" RenderTransformOrigin="0.5,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="2" Color="Black" Opacity="0.25"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    <TranslateTransform Y="-4"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Resources>
                                <!-- Step marker: number in a small ring; the line below it joins the next step -->
                                <Style x:Key="HelpStepNumber" TargetType="Border">
                                    <Setter Property="Width" Value="18"/>
                                    <Setter Property="Height" Value="18"/>
                                    <Setter Property="CornerRadius" Value="9"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Background" Value="{DynamicResource Tint14}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Tint26}"/>
                                    <Setter Property="BorderThickness" Value="0.5"/>
                                </Style>
                                <Style x:Key="HelpStepNumberText" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="9.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="HelpStepLine" TargetType="Border">
                                    <Setter Property="Width" Value="1"/>
                                    <Setter Property="Margin" Value="0,22,0,4"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Background" Value="{DynamicResource Tint1F}"/>
                                </Style>
                                <Style x:Key="HelpStepTitle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="Margin" Value="0,1,0,2"/>
                                </Style>
                                <Style x:Key="HelpBody" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="10.5"/>
                                    <Setter Property="LineHeight" Value="14.5"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                                </Style>
                                <Style x:Key="HelpTipIcon" TargetType="ui:SymbolIcon">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Width" Value="18"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
                                </Style>
                            </Border.Resources>
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{DynamicResource HelpTitle}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource HelpIntro}" Style="{StaticResource HelpBody}" Margin="0,2,0,14"/>

                                <!-- Steps -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HelpStepLine}"/>
                                    <Border Style="{StaticResource HelpStepNumber}">
                                        <TextBlock Text="1" Style="{StaticResource HelpStepNumberText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                        <TextBlock Text="{DynamicResource HelpStep1Title}" Style="{StaticResource HelpStepTitle}"/>
                                        <TextBlock Text="{DynamicResource HelpStep1Body}" Style="{StaticResource HelpBody}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HelpStepLine}"/>
                                    <Border Style="{StaticResource HelpStepNumber}">
                                        <TextBlock Text="2" Style="{StaticResource HelpStepNumberText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                        <TextBlock Text="{DynamicResource HelpStep2Title}" Style="{StaticResource HelpStepTitle}"/>
                                        <TextBlock Text="{DynamicResource HelpStep2Body}" Style="{StaticResource HelpBody}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HelpStepNumber}">
                                        <TextBlock Text="3" Style="{StaticResource HelpStepNumberText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource HelpStep3Title}" Style="{StaticResource HelpStepTitle}"/>
                                        <TextBlock Text="{DynamicResource HelpStep3Body}" Style="{StaticResource HelpBody}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Tint14}" Margin="0,14,0,12"/>

                                <!-- Good to know -->
                                <TextBlock Text="{DynamicResource HelpTipsHeader}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSec}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Collections24" Style="{StaticResource HelpTipIcon}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource HelpTipPlaylist}" Style="{StaticResource HelpBody}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ClipboardPaste24" Style="{StaticResource HelpTipIcon}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource HelpTipAutoPaste}" Style="{StaticResource HelpBody}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Warning24" Style="{StaticResource HelpTipIcon}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource HelpTipErrors}" Style="{StaticResource HelpBody}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="ErrorPopup"
                           Placement="Bottom"
                           VerticalOffset="4"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           PopupAnimation="None"
                           Closed="ErrorPopup_Closed">
                        <Border x:Name="ErrorPopupBorder" controls:LiquidGlass.Surface="Popup"
                                Background="{DynamicResource PopupBg}"
                                BorderBrush="#70E54848" BorderThickness="1"
                                anim:FluidMotion.CornerRadiusValue="55"
                                Padding="16,14" Width="390"
                                Opacity="0" RenderTransformOrigin="0.5,0">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    <TranslateTransform Y="-4"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header: icon, title (what went wrong), engine + time, close -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#26E54848" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="15" Foreground="{DynamicResource ErrorRed}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtErrorTitle" Text="{DynamicResource ErrPopupTitle}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtErrorMeta" FontSize="9.5" Foreground="{DynamicResource TextSec}" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCloseErrorPopup" Grid.Column="2"
                                            Style="{StaticResource IconBtn}" Width="24" Height="24" Padding="0" Margin="6,0,0,0"
                                            VerticalAlignment="Top" Click="CloseErrorPopup_Click"
                                            ToolTip="{DynamicResource ErrPopupClose}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextSec}"/>
                                    </Button>
                                </Grid>

                                <!-- What happened -->
                                <TextBlock x:Name="TxtPopupErrorDetails" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,12"/>

                                <!-- How to fix it: numbered steps -->
                                <TextBlock Text="{DynamicResource ErrPopupFix}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="ErrorFixSteps" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="17" Height="17" CornerRadius="8.5" Margin="0,0,8,0" VerticalAlignment="Top"
                                                        Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5">
                                                    <TextBlock Text="{Binding Number}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSec}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10.5" Foreground="{DynamicResource TextSec}"
                                                           TextWrapping="Wrap" LineHeight="14"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- The actual error message (selectable) -->
                                <TextBlock Text="{DynamicResource ErrPopupRaw}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSec}" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
                                        CornerRadius="8" Margin="0,0,0,12">
                                    <TextBox x:Name="TxtErrorRaw" Style="{x:Null}" IsReadOnly="True" TextWrapping="Wrap"
                                             MaxHeight="118" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                             Background="Transparent" BorderThickness="0" Padding="8,6"
                                             Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                             SelectionBrush="{DynamicResource Accent}"
                                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10"/>
                                </Border>

                                <!-- Actions: context action (only when one fits), copy, logs -->
                                <UniformGrid Rows="1">
                                    <Button x:Name="BtnErrorAction"
                                            Style="{StaticResource GlassPillBtn}"
                                            Margin="0,0,3,0" Height="28"
                                            Click="ErrorAction_Click"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="IconErrorAction" Symbol="ArrowClockwise24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtErrorAction" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCopyErrorDetails"
                                            Style="{StaticResource GlassPillBtn}"
                                            Margin="3,0,3,0" Height="28"
                                            Click="CopyErrorDetails_Click"
                                            ToolTip="{DynamicResource ErrPopupCopy}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource ErrPopupCopy}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnShowLogs"
                                            Style="{StaticResource GlassPillBtn}"
                                            Margin="3,0,0,0" Height="28"
                                            Click="ShowLogs_Click"
                                            ToolTip="{DynamicResource ErrPopupConsole}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Code24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource ErrPopupConsole}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ═══════════ MAIN CONTENT ═══════════ -->
            <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="14,6,14,14" Panel.ZIndex="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>



                <!-- ═══════════ CHRISTMAS TREE EASTER EGG OVERLAY (FOREGROUND) ═══════════ -->
                <Canvas x:Name="ChristmasTreeContainer" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Width="140" Height="220"
                        Margin="-18,0,0,0" Panel.ZIndex="999" Opacity="0">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="TreeScale" ScaleX="0.8" ScaleY="0.8" CenterX="70" CenterY="110"/>
                            <TranslateTransform x:Name="TreeTranslate" Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Canvas.Resources>
                        <!-- Twinkling Star Pulse -->
                        <Storyboard x:Key="StarTwinkle" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="StarGlow" Storyboard.TargetProperty="BlurRadius" From="4" To="14" Duration="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="StarGlow" Storyboard.TargetProperty="Opacity" From="0.4" To="0.9" Duration="0:0:1"/>
                        </Storyboard>
                        <!-- Gentle Tree Bobbing -->
                        <Storyboard x:Key="TreeFloat" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="TreeTranslate" Storyboard.TargetProperty="Y" From="-5" To="5" Duration="0:0:2.5"/>
                        </Storyboard>
                    </Canvas.Resources>

                    <Grid Width="140" Height="220">
                        <!-- Tree Trunk -->
                        <Border Width="18" Height="28" Background="#5C3A21" CornerRadius="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Color="#000000" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>

                        <!-- Pine Bough Layer 3 (Bottom) -->
                        <Path Data="M 10,175 L 130,175 L 70,105 Z" VerticalAlignment="Top">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#1B4D2E" Offset="0"/>
                                    <GradientStop Color="#0F331D" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Pine Bough Layer 2 (Middle) -->
                        <Path Data="M 22,125 L 118,125 L 70,65 Z" VerticalAlignment="Top">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#236B40" Offset="0"/>
                                    <GradientStop Color="#174A2C" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Pine Bough Layer 1 (Top) -->
                        <Path Data="M 34,75 L 106,75 L 70,25 Z" VerticalAlignment="Top">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#2D8A53" Offset="0"/>
                                    <GradientStop Color="#1F613A" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Ornaments -->
                        <Ellipse Width="10" Height="10" Fill="#FF453A" Margin="42,145,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF453A" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="11" Height="11" Fill="#FFD60A" Margin="88,140,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFD60A" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="9" Height="9" Fill="#64D2FF" Margin="64,155,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#64D2FF" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="#BF5AF2" Margin="48,98,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#BF5AF2" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="9" Height="9" Fill="#FF453A" Margin="80,95,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF453A" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="#FFD60A" Margin="65,52,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFD60A" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Top Star -->
                        <TextBlock Text="★" FontSize="30" Foreground="#FFD700" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="StarGlow" BlurRadius="8" ShadowDepth="0" Color="#FFD700" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Canvas>

                <!-- ──── URL BAR (full-width) ──── -->
                <!-- ──── UNIFIED FULL-WIDTH URL INPUT CAPSULE ──── -->
                <Border Grid.Row="0" Height="51" Margin="0,0,0,8" CornerRadius="50"
				        Background="{DynamicResource InputBg}"
				        BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
				        Padding="2,0,2,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. URL Text Input (Clips cleanly at column edge) -->
                        <TextBox x:Name="TxtUrl" Grid.Column="0" VerticalAlignment="Center"
						         Background="Transparent" BorderThickness="0"
						         Foreground="{DynamicResource TextPrimary}"
						         CaretBrush="{DynamicResource Accent}"
						         Padding="14,0,8,0" FontSize="12"
						         Tag="{DynamicResource UrlPlaceholder}"
						         TextChanged="TxtUrl_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
													           Foreground="{DynamicResource TextSec}" Opacity="0.6"
													           FontSize="{TemplateBinding FontSize}"
													           VerticalAlignment="Center" IsHitTestVisible="False"
													           Margin="14,0,8,0"
													           Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- 2. Vertical Separator Line 1 -->
                        <Border Grid.Column="1" Width="1" VerticalAlignment="Stretch" Margin="2,8"
						        Background="{DynamicResource BorderSub}" Opacity="0.6"/>

                        <!-- 3. Paste Button -->
                        <Button Grid.Column="2" ToolTip="{DynamicResource TipPaste}"
						        Style="{StaticResource EmbeddedCapsuleBtn}"
						        Padding="10,4" Margin="2,3" VerticalAlignment="Stretch"
						        Click="Paste_Click">
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="13.5" Opacity="0.85" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- 4. Vertical Separator Line 2 -->
                        <Border Grid.Column="3" Width="1" VerticalAlignment="Stretch" Margin="2,8"
						        Background="{DynamicResource BorderSub}" Opacity="0.6"/>

                        <!-- 5. Metadata Button -->
                        <Button Grid.Column="4" x:Name="BtnFetch"
						        Content="{DynamicResource BtnFetch}"
						        Style="{StaticResource EmbeddedCapsuleBtn}"
						        Foreground="{DynamicResource TextSec}"
						        FontSize="11.5" FontWeight="SemiBold"
						        Padding="12,4" Margin="2,3,4,3" VerticalAlignment="Stretch"
						        Click="Fetch_Click"/>
                    </Grid>
                </Border>

                <!-- ──── MODE TOGGLE (Apple iOS segmented control) ──── -->
                <Border x:Name="SegmentTrack" Grid.Row="1" CornerRadius="50" Padding="2.5" Height="34"
                        Background="{DynamicResource InputBg}"
                        BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
                        Margin="0,0,0,10"
                        ClipToBounds="True"
                        SizeChanged="SegmentTrack_SizeChanged"
                        PreviewMouseLeftButtonDown="Segment_PreviewMouseDown"
                        PreviewMouseMove="Segment_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Segment_PreviewMouseUp">
                    <Grid ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Apple Liquid Glass Capsule Indicator -->
                        <Border x:Name="SegmentIndicator" Grid.Column="0"
                                CornerRadius="50"
                                Background="{DynamicResource ActiveBg}"
                                BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5"
                                RenderTransformOrigin="0.5,0.5"
                                ClipToBounds="True">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SegmentScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="SegmentTranslateX" X="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="PillGlow" BlurRadius="5" ShadowDepth="1"
                                                  Direction="270" Color="#000000" Opacity="0.22"/>
                            </Border.Effect>
                        </Border>
                        <RadioButton x:Name="RbUpload" Style="{StaticResource SegmentedBtn}"
                                     GroupName="Mode" IsChecked="True"
                                     Checked="Mode_Changed" RenderTransformOrigin="0.5,0.5">
                            <RadioButton.RenderTransform>
                                <ScaleTransform x:Name="UploadBtnScale" ScaleX="1" ScaleY="1"/>
                            </RadioButton.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource ModeUploadTitle}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" x:Name="RbDownload"
                                     Style="{StaticResource SegmentedBtn}"
                                     GroupName="Mode" Checked="Mode_Changed"
                                     RenderTransformOrigin="0.5,0.5">
                            <RadioButton.RenderTransform>
                                <TranslateTransform x:Name="DownloadTranslateX"/>
                            </RadioButton.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon x:Name="IconDownloadMode" Symbol="ArrowDownload24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtModeDownloadTitle" Text="{DynamicResource ModeDownloadTitle}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Border>

                <!-- ──── Two-column layout ──── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ LEFT: Preview ═══ -->
                    <Grid Grid.Column="0">
                        <!-- Skeleton Loading Wireframe Card for MainWindow (Image 2 style: no text, pulsating rounded pill bars) -->
                        <Border x:Name="BorderMetaSkeleton" Style="{StaticResource Card}"
                                Visibility="Collapsed" Opacity="0" Padding="0"
                                helpers:ClipHelper.CornerRadiusClip="True"
                                ClipToBounds="True" Margin="0">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.30" To="0.85" Duration="0:0:0.75"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Skeleton Thumbnail Container -->
                                <Border x:Name="ThumbSkeletonBorder" Grid.Row="0" CornerRadius="16,16,0,0"
                                        helpers:ClipHelper.CornerRadiusClip="True"
                                        Background="{DynamicResource ThumbGrad}"
                                        ClipToBounds="True" Height="185" Opacity="0.5">
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Video24" FontSize="36" Foreground="{DynamicResource TextSec}" Opacity="0.3"/>
                                    </Grid>
                                </Border>

                                <!-- Skeleton Horizontal Pill Bars (Image 2 design: rounded title & subtitle bars) -->
                                <StackPanel Grid.Row="1" Margin="14,14,14,14">
                                    <Border Height="14" CornerRadius="7" Background="{DynamicResource TextSec}"
                                            Opacity="0.35" HorizontalAlignment="Left" Width="170" Margin="0,0,0,8"/>
                                    <Border Height="11" CornerRadius="5.5" Background="{DynamicResource TextSec}"
                                            Opacity="0.22" HorizontalAlignment="Left" Width="230"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="BorderMeta" Style="{StaticResource Card}"
                                Visibility="Collapsed" Opacity="0" Padding="0"
                                helpers:ClipHelper.CornerRadiusClip="True"
                                ClipToBounds="True" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Thumbnail -->
                                <Border x:Name="ThumbBgBorder" Grid.Row="0"
                                        CornerRadius="16,16,0,0"
                                        helpers:ClipHelper.CornerRadiusClip="True"
                                        Background="{DynamicResource ThumbGrad}"
                                        ClipToBounds="True" Height="185">
                                    <Grid>
                                        <TextBlock x:Name="TxtMetaThumbFallback" Text="🎥"
                                                   FontSize="36" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Image x:Name="ImgThumbnail" Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- Subtle darken overlay -->
                                        <Border Background="#14000000" IsHitTestVisible="False"/>

                                        <!-- Duration Timestamp Liquid Glass Badge Pill (Bottom-Right overlay) -->
                                        <Border x:Name="BorderDurationBadge"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,8,8" Padding="7,2.5" CornerRadius="6"
                                                Background="#E616171E"
                                                BorderBrush="#55FFFFFF" BorderThickness="0.8"
                                                Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.6"/>
                                            </Border.Effect>
                                            <Grid>
                                                <!-- Glass top specular highlight overlay -->
                                                <Border Height="6" VerticalAlignment="Top" CornerRadius="6,6,0,0" IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock x:Name="TxtMetaDuration"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="#FFFFFF"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#000000" Opacity="0.6"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Row="1" Margin="14,10,14,6">
                                    <TextBlock x:Name="TxtMetaTitle" FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap" MaxHeight="48"
                                               TextTrimming="CharacterEllipsis" LineHeight="16"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="TxtMetaUploader" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSec}"/>
                                        <TextBlock x:Name="TxtMetaAlbum" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSec}"
                                                   Margin="8,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="TagsList" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="6,2.5"
                                                        Margin="0,0,4,4"
                                                        Background="{DynamicResource InputBg}"
                                                        BorderBrush="{DynamicResource BorderSub}"
                                                        BorderThickness="0.5">
                                                    <TextBlock Text="{Binding}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextSec}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Quick actions (integrated card footer inheriting liquid glass material) -->
                                <Border Grid.Row="2"
                                        CornerRadius="0,0,16,16"
                                        Background="#12000000"
                                        BorderBrush="{DynamicResource BorderSub}"
                                        BorderThickness="0,0.5,0,0" Padding="12,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Click="ClearForm_Click" Padding="4,3"
                                                ToolTip="{DynamicResource TipClearForm}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Padding="4,3" Click="CopyTitle_Click" ToolTip="Copy title">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Document24" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtQuickCopyTitle" Text="Title" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Padding="4,3" Margin="8,0,0,0" Click="CopyUrl_Click" ToolTip="Copy URL">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Link24" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtQuickCopyUrl" Text="URL" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Padding="4,3" Margin="8,0,0,0" Click="OpenInBrowser_Click" ToolTip="Open in browser">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Globe24" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtQuickOpenBrowser" Text="Browser" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Padding="4,3" Margin="8,0,0,0" Click="SaveThumbnail_Click" ToolTip="Save thumbnail">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Save24" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtQuickSaveThumb" Text="Save" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═══ RIGHT: Settings & Actions ═══ -->
                    <Grid Grid.Column="2">
                        <!-- UPLOAD SETTINGS (Stretches full height, large description box fills middle) -->
                        <Border x:Name="BorderUpload" Style="{StaticResource Card}"
                                VerticalAlignment="Stretch" Margin="0"
                                Visibility="Collapsed" Opacity="0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{DynamicResource LblTitleField}" FontSize="10"
                                                   Foreground="{DynamicResource TextSec}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtTitle"/>
                                    <Grid Margin="0,8,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource LblDescField}" FontSize="10"
                                                       Foreground="{DynamicResource TextSec}"
                                                       VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource IconBtn}"
                                                    ToolTip="{DynamicResource TipEditDesc}"
                                                    Click="EditDescription_Click">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="11" Foreground="{DynamicResource TextSec}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Text="{DynamicResource LblVisibility}" FontSize="10"
                                                   Foreground="{DynamicResource TextSec}" Margin="0,8,0,3"/>
                                    <ComboBox x:Name="CmbPrivacy" SelectedIndex="0">
                                        <ComboBoxItem Content="{DynamicResource PrivacyPublic}"   Tag="public"/>
                                        <ComboBoxItem Content="{DynamicResource PrivacyUnlisted}" Tag="unlisted"/>
                                        <ComboBoxItem Content="{DynamicResource PrivacyPrivate}"  Tag="private"/>
                                    </ComboBox>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkFingerprint" Style="{StaticResource GlassToggleSwitchLabeled}" IsChecked="True" VerticalAlignment="Center" Content="Fingerprint" FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbFingerprintMethod" Grid.Column="1"
                                                      Margin="8,0,0,0" SelectedIndex="2"
                                                      IsEnabled="{Binding IsChecked, ElementName=ChkFingerprint}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                            <ComboBoxItem Content="{DynamicResource FpMetadata}" Tag="metadata"/>
                                            <ComboBoxItem Content="{DynamicResource FpLight}"    Tag="light"/>
                                            <ComboBoxItem Content="{DynamicResource FpStandard}" Tag="standard"/>
                                            <ComboBoxItem Content="{DynamicResource FpStrong}"   Tag="strong"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- Description Box stretches to fill available middle height -->
                                <TextBox x:Name="TxtDescription" IsReadOnly="True"
                                             TextWrapping="Wrap" MinHeight="60"
                                             VerticalAlignment="Stretch"
                                             Margin="0,0,0,4"
                                             BorderBrush="{DynamicResource BorderSub}"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="{DynamicResource TipDescBox}"
                                             MouseDoubleClick="EditDescription_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- DOWNLOAD & COMPLETED ACTIONS GROUP -->
                        <Grid x:Name="GridDownloadGroup" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Actions fill the rest; MaxHeight is set in code so buttons don't grow huge -->
                                <RowDefinition x:Name="RowCompletedActions" Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- DOWNLOAD SETTINGS (Compact natural card aligned to top) -->
                            <Border x:Name="BorderDownload" Grid.Row="0" Style="{StaticResource Card}"
                                        VerticalAlignment="Top" Margin="0"
                                        Padding="14,8"
                                        Visibility="Visible" Opacity="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LblDlTitle}" FontSize="10"
                                               Foreground="{DynamicResource TextSec}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtTitleDl"
                                             Tag="{DynamicResource DlTitlePlaceholder}"/>
                                    <TextBlock Text="{DynamicResource LblQuality}" FontSize="10"
                                               Foreground="{DynamicResource TextSec}" Margin="0,4,0,2"/>
                                    <ComboBox x:Name="CmbQuality" SelectedIndex="0">
                                        <ComboBoxItem x:Name="CmbItemBest" Content="{DynamicResource QualityBest}" Tag="best"/>
                                        <ComboBoxItem x:Name="CmbItem1080" Content="1080p" Tag="1080"/>
                                        <ComboBoxItem x:Name="CmbItem720" Content="720p" Tag="720"/>
                                        <ComboBoxItem x:Name="CmbItem480" Content="480p" Tag="480"/>
                                        <ComboBoxItem x:Name="CmbItem360" Content="360p" Tag="360"/>
                                        <ComboBoxItem x:Name="CmbItemAudio" Content="{DynamicResource QualityAudio}" Tag="audio"/>
                                        <ComboBoxItem x:Name="CmbItemYt320" Content="{DynamicResource QualityYTMusic320}" Tag="ytmusic_320k" Visibility="Collapsed"/>
                                        <ComboBoxItem x:Name="CmbItemYtM4a" Content="{DynamicResource QualityYTMusicM4a}" Tag="ytmusic_m4a" Visibility="Collapsed"/>
                                        <ComboBoxItem x:Name="CmbItemYtFlac" Content="{DynamicResource QualityYTMusicFlac}" Tag="ytmusic_flac" Visibility="Collapsed"/>
                                    </ComboBox>
                                    <!-- Save Destination Header & Mode Toggle -->
                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource LblSavePath}" FontSize="10"
                                                    Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkCloudUpload" Style="{StaticResource GlassToggleSwitchLabeledLeft}"
                                                      Content="Cloud" Foreground="{DynamicResource TextSec}" FontSize="10" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Click="ChkCloudUpload_Click"
                                                       ToolTip="{DynamicResource TipCloudUpload}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Standard Local Save Path -->
                                    <controls:ExpandPresenter x:Name="ExpandLocalSave" Progress="1">
                                        <Grid x:Name="PanelLocalSave">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtOutputDir" IsReadOnly="True"/>
                                            <Button Grid.Column="1"
                                                     Style="{StaticResource OutlineBtn}"
                                                     Content="{DynamicResource BtnBrowse}"
                                                     Margin="8,0,0,0" Click="Browse_Click"/>
                                        </Grid>
                                    </controls:ExpandPresenter>

                                    <!-- Instant Cloud Upload Capsule -->
                                    <controls:ExpandPresenter x:Name="ExpandCloudSave">
                                        <Border x:Name="PanelCloudSave"
                                                 Background="{DynamicResource InputBg}"
                                                 BorderBrush="{DynamicResource BorderSub}"
                                                 BorderThickness="0.5" CornerRadius="8" Padding="9,6"
                                                 Margin="0,2,0,0">
                                            <StackPanel>
                                                <!-- Provider Select & Setup -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="CmbCloudProvider" SelectionChanged="CmbCloudProvider_SelectionChanged"
                                                               Height="27" VerticalAlignment="Center" SelectedIndex="0">
                                                        <ComboBoxItem Content="Google Drive" Tag="gdrive"/>
                                                        <ComboBoxItem Content="Dropbox" Tag="dropbox"/>
                                                        <ComboBoxItem Content="Microsoft OneDrive" Tag="onedrive"/>
                                                        <ComboBoxItem Content="Discord / Webhook" Tag="webhook"/>
                                                        <ComboBoxItem Content="{DynamicResource CloudProviderCustom}" Tag="custom"/>
                                                    </ComboBox>
                                                    <Button x:Name="BtnCloudConfig" Grid.Column="1" Style="{StaticResource OutlineBtn}"
                                                             Height="27" Margin="6,0,0,0" Padding="8,0" Click="BtnCloudConfig_Click"
                                                             ToolTip="{DynamicResource TipCloudConfig}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Settings24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{DynamicResource BtnSetup}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- Target & Status Row -->
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtCloudTargetStatus" Text="Google Drive: Ready"
                                                                FontSize="9.5" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"/>
                                                    <Button x:Name="BtnChangeCloudFolder" Grid.Column="1" Style="{StaticResource IconBtn}"
                                                             Padding="3" Click="BtnChangeCloudFolder_Click" ToolTip="{DynamicResource TipChangeCloudFolder}"
                                                             Cursor="Hand">
                                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="11" Foreground="{DynamicResource TextSec}"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </controls:ExpandPresenter>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkFingerprintDl" Style="{StaticResource GlassToggleSwitchLabeled}" IsChecked="True" VerticalAlignment="Center" Content="Fingerprint" FontSize="11" Width="103"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbFingerprintMethodDl" Grid.Column="1"
                                                  Margin="8,0,0,0" SelectedIndex="2"
                                                  IsEnabled="{Binding IsChecked, ElementName=ChkFingerprintDl}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                            <ComboBoxItem Content="{DynamicResource FpMetadata}" Tag="metadata"/>
                                            <ComboBoxItem Content="{DynamicResource FpLight}"    Tag="light"/>
                                            <ComboBoxItem Content="{DynamicResource FpStandard}" Tag="standard"/>
                                            <ComboBoxItem Content="{DynamicResource FpStrong}"   Tag="strong"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- COMPLETED ACTIONS CONTAINER (shown after successful job) -->
                            <Border x:Name="BorderCompletedActions" Style="{StaticResource Card}"
                                    Grid.Row="1" VerticalAlignment="Stretch"
                                    Padding="10,5"
                                    Visibility="Collapsed" Opacity="0"
                                    Margin="0,8,0,0">
                                <UniformGrid x:Name="GridCompletedActions" Columns="1">
                                    <Button x:Name="BtnOpenCloudLink"
                                        Style="{StaticResource OutlineBtn}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Margin="0,0,0,3.5"
                                        Click="OpenCloudLink_Click"
                                        Visibility="Collapsed"
                                        ToolTip="{DynamicResource TipOpenCloudLink}"
                                        Cursor="Hand">
                                        <StackPanel x:Name="PanelBtnOpenCloudLink" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="IconOpenCloudLink" Symbol="Link24" FontSize="12.5" Foreground="{DynamicResource Accent}" Margin="0,0,5.5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtBtnOpenCloudLink" Text="Open Cloud Link"
                                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnOpenFileLocation"
                                        Style="{StaticResource OutlineBtn}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Margin="0,0,0,3.5"
                                        Click="OpenFileLocation_Click"
                                        ToolTip="{DynamicResource BtnOpenFileLocation}"
                                        Cursor="Hand">
                                        <StackPanel x:Name="PanelBtnOpenFileLocation" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="IconOpenFileLocation" Symbol="FolderOpen24" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,5.5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtBtnOpenFileLocation" Text="{DynamicResource BtnOpenFileLocation}"
                                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnOpenInEditor"
                                        Style="{StaticResource OutlineBtn}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Margin="0,0,0,3.5"
                                        Click="OpenInEditor_Click"
                                        ToolTip="{DynamicResource BtnOpenInEditor}"
                                        Cursor="Hand">
                                        <StackPanel x:Name="PanelBtnOpenInEditor" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="IconOpenInEditor" Symbol="VideoClip24" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,5.5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtBtnOpenInEditor" Text="{DynamicResource BtnOpenInEditor}"
                                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnGenerateSubtitles"
                                        Style="{StaticResource OutlineBtn}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Click="GenerateSubtitles_Click"
                                        ToolTip="{DynamicResource BtnGenSubtitles}"
                                        Cursor="Hand">
                                        <StackPanel x:Name="PanelBtnGenSubtitles" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="IconGenSubtitles" Symbol="ClosedCaption24" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,5.5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtBtnGenSubtitles" Text="{DynamicResource BtnGenSubtitles}"
                                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- UNIFIED MORPHING START BUTTON & INTEGRATED LOG CAPSULE -->
                <Border x:Name="StartContainer" Grid.Row="3" Height="42" Margin="0,4,0,0" CornerRadius="21"
                        Background="{DynamicResource InputBg}"
                        BorderBrush="{DynamicResource BorderSub}"
                        BorderThickness="0.5"
                        ClipToBounds="True"
                        Cursor="Hand"
                        MouseLeftButtonDown="StartContainer_Click">
                    <Grid x:Name="StartGrid">
                        <!-- 1. Idle Glass Background -->
                        <Border x:Name="StartIdleBg" CornerRadius="22">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#36FFFFFF" Offset="0"/>
                                    <GradientStop Color="#24FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#50FFFFFF" Offset="0"/>
                                    <GradientStop Color="#20FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>

                        <!-- 2. Inner Glass Track Groove (Visible when running) -->
                        <Border x:Name="StartTrackGroove" CornerRadius="22" Background="#20000000" Visibility="Collapsed"/>

                        <!-- 3. Morphing Floating Color-Free Transparent Glass Progress Capsule -->
                        <Border x:Name="StartProgressFill" Height="38" Margin="3" CornerRadius="19"
                                Width="0" HorizontalAlignment="Left" ClipToBounds="True"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect x:Name="StartProgressGlow" BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.35"/>
                            </Border.Effect>
                            <Border.Background><DynamicResource ResourceKey="Tint24"/></Border.Background>
                            <Grid>
                                <!-- Pure Specular Top Gloss Highlight -->
                                <Border Height="19" VerticalAlignment="Top" CornerRadius="19,19,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#55FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- Pure Glass Rim Stroke -->
                                <Border CornerRadius="19" BorderThickness="0.8" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#65FFFFFF" Offset="0"/>
                                            <GradientStop Color="#15FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#25FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>
                                <!-- Bottom Refraction Line -->
                                <Border Height="1" VerticalAlignment="Bottom" Margin="6,0,6,1.5" Background="{DynamicResource Tint25}"/>
                            </Grid>
                        </Border>

                        <!-- 4. Overlay Grid (Status Label) -->
                        <Grid Margin="2,0">
                            <!-- Floating Label Overlay -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="16,0">
                                <TextBlock x:Name="TxtStartLabel" Text="{DynamicResource BtnStart}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="{DynamicResource TextShadowOpacity}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- 5. Glass Refraction Overlay for Entire Container -->
                        <Border CornerRadius="22" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#18FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#0CFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </Grid>



            <!-- ═══════════ LANGUAGE SELECTOR POPUP ═══════════ -->
            <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=BtnLangPill}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True"
                   PopupAnimation="None" Closed="LangPopup_Closed">
                <Border x:Name="LangPopupBorder" controls:LiquidGlass.Surface="Popup"
                        Background="{DynamicResource PopupBg}"
                        BorderBrush="{DynamicResource BorderSub}"
                        BorderThickness="0.5" CornerRadius="12"
                        Padding="4,6" Margin="0,4,0,0" MinWidth="135"
                        RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                            <TranslateTransform Y="-6"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="Black" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="en">
                            <Grid Width="175">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="English" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <ui:SymbolIcon Symbol="Checkmark24" x:Name="CheckLangEN" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="de" Opacity="0.75">
                            <Grid Width="175">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Deutsch" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSec}"/>
                                    <Border Background="{DynamicResource Tint14}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="4" Margin="6,0,0,0" Padding="4,1">
                                        <TextBlock Text="Unsupported" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSec}"/>
                                    </Border>
                                </StackPanel>
                                <ui:SymbolIcon Symbol="Checkmark24" x:Name="CheckLangDE" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" HorizontalContentAlignment="Left" Padding="8,5" Click="SelectLang_Click" Tag="ru" Opacity="0.75">
                            <Grid Width="175">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Русский" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSec}"/>
                                    <Border Background="{DynamicResource Tint14}" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.5" CornerRadius="4" Margin="6,0,0,0" Padding="4,1">
                                        <TextBlock Text="Unsupported" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSec}"/>
                                    </Border>
                                </StackPanel>
                                <ui:SymbolIcon Symbol="Checkmark24" x:Name="CheckLangRU" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="32" Height="32" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style corner: arc along the window's rounded corner, lens on hover -->
                <controls:CornerResizeGlyph/>
            </Border>
        </Grid>
    </helpers:SquircleBorder>
</Window>