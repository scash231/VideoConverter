<Window x:Class="VideoConverterUI.GlassTunerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass Tuner" Width="480" Height="780" MinWidth="400" MinHeight="420"
        Icon="Icons/app.ico" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <!-- Developer tool: plain Win32 window, rows are generated in code (GlassTunerWindow.BuildRows). -->
    <DockPanel Margin="16,14,16,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Liquid Glass" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource TextSec}"
                       Text="Changes apply live to every open surface of the selected kind. Put busy content behind it to judge the lensing."/>
            <DockPanel Margin="0,12,0,0">
                <TextBlock Text="Surface" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSec}"/>
                <ComboBox x:Name="CmbSurface" Width="150" SelectionChanged="Surface_Changed"/>
                <TextBlock x:Name="TxtSurfaceInfo" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSec}"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Editing" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSec}"/>
                <RadioButton x:Name="RadDark" Content="Dark mode" GroupName="GlassMode" Foreground="{DynamicResource TextPrimary}" Checked="Mode_Checked" Margin="0,0,14,0"/>
                <RadioButton x:Name="RadLight" Content="Light mode" GroupName="GlassMode" Foreground="{DynamicResource TextPrimary}" Checked="Mode_Checked"/>
            </StackPanel>
            <TextBlock x:Name="TxtModeHint" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextSec}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <!-- Preview for the selected surface (Surface_Changed shows the matching one) -->
            <StackPanel x:Name="PreviewNotification" Orientation="Horizontal">
                <ComboBox x:Name="CmbType" Width="110" SelectedIndex="0">
                    <ComboBoxItem Content="Error"/>
                    <ComboBoxItem Content="Success"/>
                    <ComboBoxItem Content="Info"/>
                    <ComboBoxItem Content="Warning"/>
                </ComboBox>
                <Button Content="Show test notification" Margin="8,0,0,0" Padding="12,5" Click="Test_Click"/>
            </StackPanel>
            <StackPanel x:Name="PreviewDropdown" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="Open it:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSec}"/>
                <ComboBox Width="160" SelectedIndex="1">
                    <ComboBoxItem Content="Public"/>
                    <ComboBoxItem Content="Unlisted"/>
                    <ComboBoxItem Content="Private"/>
                    <ComboBoxItem Content="The quick brown fox"/>
                    <ComboBoxItem Content="jumps over the lazy dog"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="PreviewOther" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSec}" Text="Open a place in the app that uses this surface to see it."/>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="Reset" Padding="12,5" Margin="0,0,8,0" Click="Reset_Click"
                        ToolTip="Back to the shipped values for this surface and mode (not saved until you click Save)."/>
                <Button Content="Copy as C#" Padding="12,5" Margin="0,0,8,0" Click="Copy_Click"
                        ToolTip="This surface's two modes as GlassParams initializers, to bake them in as the new defaults (GlassTuning.Registry)."/>
                <Button Content="Save" Padding="12,5" Margin="0,0,8,0" Click="Save_Click"
                        ToolTip="Keep the values of every surface across restarts (%APPDATA%\VideoConverter\glass.json)."/>
                <Button Content="Delete saved" Padding="12,5" Click="DeleteSaved_Click"
                        ToolTip="Remove glass.json; the next start uses the shipped values again."/>
            </WrapPanel>
            <TextBlock x:Name="TxtStatus" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSec}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel x:Name="Rows" Margin="0,0,10,0"/>
        </ScrollViewer>
    </DockPanel>
</Window>
