 <Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:VideoConverterUI.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="VideoConverterUI.BatchSavePromptDialog"
        Title="Save Progress?"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Storyboard x:Key="FadeInDialog">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut"
                                 Oscillations="1"
                                 Springiness="7"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1" Duration="0:0:0.37"
                             BeginTime="0:0:0.02">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut"
                                 Oscillations="1"
                                 Springiness="7"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeOutDialog">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="0.93" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="0.93" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <services:SquircleBorder
        x:Name="RootBorder" controls:LiquidGlass.Surface="Dialog"
        CornerRadius="10"
        Background="{DynamicResource BgDeep}"
        BorderBrush="{DynamicResource BorderSub}"
        BorderThickness="1"
        RenderTransformOrigin="0.5,0.5">

        <services:SquircleBorder.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale"
                                 ScaleX="1"
                                 ScaleY="1"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </services:SquircleBorder.RenderTransform>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar / Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock
                        Text="Save Progress?"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextSec}"
                        Opacity="0.75"
                        Margin="0,2,0,0">
                        <Run Text="You have unsaved items in your queue"/>
                        <Run Language="de-de" Text=""/>
                    </TextBlock>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    x:Name="BtnClose"
                    Style="{StaticResource IconBtn}"
                    Width="26"
                    Height="26"
                    Click="BtnCancel_Click"
                    ToolTip="Cancel"
                    VerticalAlignment="Center">

                    <ui:SymbolIcon
                        Symbol="Dismiss24"
                        FontSize="11"
                        Foreground="{DynamicResource TextSec}"/>
                </Button>
            </Grid>

            <!-- Action Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal">

                    <Button
                        x:Name="BtnDontSave"
                        Content="Don't Save"
                        Click="BtnDontSave_Click"
                        Style="{StaticResource OutlineBtn}"
                        Height="32"
                        Padding="14,0"
                        Margin="0,0,8,0"/>

                    <Button
                        x:Name="BtnSave"
                        Content="Save &amp; Exit"
                        Click="BtnSave_Click"
                        Style="{StaticResource GradRectBtn}"
                        Height="32"
                        Padding="18,0"/>
                </StackPanel>

                <CheckBox
                    x:Name="ChkDontAskAgain"
                    Content="Dont ask again"
                    FontSize="11"
                    Foreground="{DynamicResource TextPrimary}"
                    VerticalAlignment="Center"
                    IsChecked="False"
                    Background="White"
                    BorderBrush="White"
                    Style="{DynamicResource GlassToggleSwitchLabeled}"
                    Template="{DynamicResource GlassCapsuleToggleTemplate}" Margin="0,0,57,0" Height="32"/>
            </Grid>
        </Grid>
    </services:SquircleBorder>
</Window>