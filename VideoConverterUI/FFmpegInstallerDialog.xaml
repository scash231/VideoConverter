<Window x:Class="VideoConverterUI.FFmpegInstallerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:anim="clr-namespace:VideoConverterUI.Animations"
        Title="FFmpeg Setup" Width="460"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Storyboard x:Key="FadeInDialog">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="7"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1" Duration="0:0:0.37"
                             BeginTime="0:0:0.02">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="7"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOutDialog">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="0.93" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="0.93" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" controls:LiquidGlass.Surface="Dialog" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="WindowTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title / Header -->
                <RowDefinition Height="Auto"/> <!-- Content Body -->
                <RowDefinition Height="Auto"/> <!-- Progress / Status -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- ═══ Title Bar / Header ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource FfmpegDialogTitle}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Border Background="#1A7A9EC0" BorderBrush="#357A9EC0" BorderThickness="0.5"
                                CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource FfmpegRequiredBadge}" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource FfmpegSubtitle}" FontSize="11"
                               Foreground="{DynamicResource TextSec}" Opacity="0.75" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnClose" Style="{StaticResource IconBtn}"
                        Width="26" Height="26" Click="BtnCancel_Click" ToolTip="{DynamicResource BtnClose}"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextSec}"/>
                </Button>
            </Grid>

            <!-- ═══ Body / Options ═══ -->
            <StackPanel Grid.Row="1" x:Name="PanelPrompt" Margin="0,0,0,16">

                <!-- Installation Destination & PATH Options -->
                <Border Background="{DynamicResource Tint08}" BorderBrush="{DynamicResource Tint10}" BorderThickness="0.5"
                        CornerRadius="12" Padding="14,10">
                    <StackPanel>
                        <!-- User PATH Row -->
                        <Grid Margin="0,3,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource FfmpegPathUserTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource FfmpegPathUserDesc}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,1,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAddToUserPath" Style="{DynamicResource GlassToggleSwitch}" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- System PATH Row -->
                        <Grid Margin="0,5,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource FfmpegPathSystemTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource FfmpegPathSystemDesc}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.7" Margin="0,1,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAddToSystemPath" Style="{DynamicResource GlassToggleSwitch}" Grid.Column="1" IsChecked="False" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Progress & Status View ═══ -->
            <StackPanel Grid.Row="2" x:Name="PanelProgress" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="TxtStatus" Text="{DynamicResource FfmpegStatusDownloading}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPercent" Text="0%" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Liquid Glass Progress Bar -->
                <Border Height="8" CornerRadius="4" Background="{DynamicResource Tint18}" BorderBrush="{DynamicResource Tint20}"
                        BorderThickness="0.5" ClipToBounds="True" Margin="0,0,0,8">
                    <Grid>
                        <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0"
                                CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7A9EC0" Offset="0"/>
                                    <GradientStop Color="#9DB8D2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtDetail" Text="{DynamicResource FfmpegDetailConnecting}"
                           FontSize="10.5" Foreground="{DynamicResource TextSec}" Opacity="0.8"/>
            </StackPanel>

            <!-- ═══ Action Buttons ═══ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtInstallInfo" Text="{DynamicResource FfmpegDownloadSize}" FontSize="10" Foreground="{DynamicResource TextSec}" Opacity="0.6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnCancel" Content="{DynamicResource BtnCancelSettings}" Click="BtnCancel_Click"
                            Style="{StaticResource OutlineBtn}" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                    
                    <Button x:Name="BtnInstall" Content="{DynamicResource FfmpegBtnDownloadInstall}" Click="BtnInstall_Click"
                            Style="{StaticResource GradRectBtn}" Height="32" Padding="18,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
