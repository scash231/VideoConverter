<Window x:Class="VideoConverterUI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:VideoConverterUI.Services"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        Title="Notification"
        MinWidth="280" MaxWidth="520"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <!-- Margin leaves room for the shadow and for the fly-in, which starts above the card's resting place. -->
    <Grid x:Name="RootGrid" Margin="34,56,34,28">
        <!-- Apple Liquid Glass card (LiquidGlassPanel, surface "Notification"): shows the parent window behind it
             (BackdropSource, set in SetupGlass) and drives RootBorder's drop shadow. -->
        <services:SquircleBorder x:Name="RootBorder"
        CornerRadius="14"
        MinWidth="280"
        Background="Transparent"
        RenderTransformOrigin="0.5,0"
        HorizontalAlignment="Left"
        MouseLeftButtonDown="Notification_Click">

            <services:SquircleBorder.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="WindowTranslate" X="0" Y="0"/>
                </TransformGroup>
            </services:SquircleBorder.RenderTransform>

            <services:SquircleBorder.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.18"/>
            </services:SquircleBorder.Effect>

            <controls:LiquidGlassPanel x:Name="CardGrid" Surface="Notification">
                <!-- Main Content Area (sharpens out of a blur during the fly-in) -->
                <Grid x:Name="ContentArea" Margin="16,12,14,18">
                    <Grid.Effect>
                        <BlurEffect x:Name="ContentBlur" Radius="0"/>
                    </Grid.Effect>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Notification Type Icon -->
                    <ui:SymbolIcon x:Name="IconNotify" Symbol="Info24" FontSize="19" Margin="0,0,12,0"
                                   Foreground="#3B82F6" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                    <!-- Notification Message Text -->
                    <TextBlock x:Name="TxtMessage" Grid.Column="1" Text="Notification message..."
                               Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxWidth="430" VerticalAlignment="Center" LineHeight="17"
                               IsHitTestVisible="False"/>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="22" Height="22" Margin="12,0,0,0"
                            Click="Close_Click" VerticalAlignment="Center" ToolTip="Close">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" Foreground="{DynamicResource TextSec}"/>
                    </Button>
                </Grid>

                <!-- Fully Rounded Pill Countdown Progress Bar (No Background Track) -->
                <Border Height="3" Margin="16,0,16,8" VerticalAlignment="Bottom" CornerRadius="10"
                        Background="Transparent" ClipToBounds="True" IsHitTestVisible="False">
                    <Rectangle x:Name="ProgressLine" Height="3" HorizontalAlignment="Stretch" Fill="#3B82F6"
                               RadiusX="10" RadiusY="10">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Border>

            </controls:LiquidGlassPanel>
        </services:SquircleBorder>
    </Grid>
</Window>
