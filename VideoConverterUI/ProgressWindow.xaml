<Window x:Class="VideoConverterUI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource ProgressWindowTitle}" Width="420"
        SizeToContent="Height"
        Icon="Icons/ProgressWindow.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource Tint25}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WinScale"/>
                <TranslateTransform x:Name="WinTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <TextBlock Text="{DynamicResource ProgressWindowTitle}" FontWeight="SemiBold"
                               FontSize="12" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button x:Name="BtnCloseWindow" HorizontalAlignment="Right"
                            Style="{StaticResource IconBtn}"
                            Foreground="{DynamicResource TextSec}"
                            Width="30" Height="30" Margin="0,2,4,0"
                            ToolTip="{DynamicResource ProgressWindowCloseTip}"
                            Click="CloseWindow_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Progress content -->
            <StackPanel Grid.Row="1" Margin="16,12,16,0">
                <Grid x:Name="RowMsgPct" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtProgressMsg"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtProgressPct" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Border x:Name="ProgressTrack" Height="10" CornerRadius="5"
                        Background="#18000000" BorderBrush="{DynamicResource BorderSub}" BorderThickness="0.6" ClipToBounds="False">
                    <Border x:Name="ProgressFill" CornerRadius="5"
                            HorizontalAlignment="Left" Width="0" ClipToBounds="False">
                        <Border.Effect>
                            <DropShadowEffect x:Name="ProgressGlow" BlurRadius="0" ShadowDepth="0" Color="#FFFFFF" Opacity="0"/>
                        </Border.Effect>
                        <Border.Background><DynamicResource ResourceKey="Tint2A"/></Border.Background>
                        <Grid>
                            <!-- Pure Specular Top Gloss Highlight -->
                            <Border Height="5" VerticalAlignment="Top" CornerRadius="5,5,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Pure Glass Rim Stroke -->
                            <Border CornerRadius="5" BorderThickness="0.8" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#60FFFFFF" Offset="0"/>
                                        <GradientStop Color="#20FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <Grid x:Name="RowDetail" Margin="0,6,0,0">
                    <TextBlock x:Name="TxtEta" FontSize="11"
                               Foreground="{DynamicResource TextSec}"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtProgressDetail"
                               Foreground="{DynamicResource TextSec}"
                               TextTrimming="CharacterEllipsis"
                               Margin="55,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Footer row: countdown + open folder + console toggle + button -->
            <Grid Grid.Row="2" Margin="16,8,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtCountdown" FontSize="11"
                           Foreground="{DynamicResource TextSec}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <Button x:Name="BtnOpenFolder" Grid.Column="1"
                        Style="{StaticResource OutlineBtn}"
                        Margin="0,0,6,0"
                        Visibility="Collapsed"
                        Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BtnOpenFolder}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnToggleLog" Grid.Column="2"
                        Style="{StaticResource OutlineBtn}"
                        Margin="0,0,6,0"
                        Click="ToggleLog_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource LogTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnCancel" Grid.Column="3"
                        Content="{DynamicResource BtnCancel}" Style="{StaticResource OutlineBtn}"
                        Click="Cancel_Click"/>
            </Grid>

            <!-- Console (toggleable) -->
            <TextBox x:Name="TxtConsole" Grid.Row="3"
                     Margin="16,0,16,12"
                     Background="{DynamicResource InputBg}"
                     BorderBrush="{DynamicResource Tint15}" BorderThickness="1"
                     Foreground="{DynamicResource Accent}"
                     FontFamily="Consolas"
                     FontSize="10"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MaxHeight="140"
                     Padding="8,6"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Visibility="Collapsed"/>
            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="32" Height="32" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style corner: arc along the window's rounded corner, lens on hover -->
                <controls:CornerResizeGlyph/>
            </Border>
        </Grid>
    </Border>
</Window>
