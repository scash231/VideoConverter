<Window x:Class="VideoConverterUI.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoConverterUI.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource JobLogTitle}" Width="500" Height="360"
        WindowStyle="None" AllowsTransparency="True"
        Icon="Icons/app.ico"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="{DynamicResource BgDeep}"
            BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
            Opacity="100" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WinScale"/>
                <TranslateTransform x:Name="WinTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="{DynamicResource JobLogTitle}" FontWeight="SemiBold"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtJobHash" Text=""
                                   FontSize="10" FontWeight="Normal"
                                   Foreground="{DynamicResource TextSec}" Opacity="0.75"
                                   Margin="6,1,0,0" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource IconBtn}"
                            Foreground="{DynamicResource TextSec}"
                            Width="30" Height="30"
                            HorizontalAlignment="Right" Margin="0,5,8,-1"
                            Click="Close_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Log TextBox -->
            <TextBox x:Name="TxtLog" Grid.Row="1"
                     Margin="12,10,12,0"
                     Background="{DynamicResource BgDeep}"
                     BorderBrush="{DynamicResource BorderSub}" BorderThickness="1"
                     Foreground="{DynamicResource ConsoleText}"
                     FontFamily="Verdana"
                     FontSize="10"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="8,6"/>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="12,8,12,12">
                <Button Style="{StaticResource OutlineBtn}"
                        HorizontalAlignment="Left"
                        Click="Copy_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BtnCopy}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="{DynamicResource BtnClose}" Style="{StaticResource OutlineBtn}"
                        HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>
            <!-- Corner Resize Grip Handle -->
            <Border x:Name="WindowCornerGrip"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="32" Height="32" Margin="0,0,0,0"
                    Background="Transparent" Cursor="SizeNWSE"
                    Panel.ZIndex="9999"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="WindowCornerGrip_MouseDown"
                    MouseEnter="WindowCornerGrip_MouseEnter"
                    MouseLeave="WindowCornerGrip_MouseLeave">
                <!-- iPadOS-style corner: arc along the window's rounded corner, lens on hover -->
                <controls:CornerResizeGlyph/>
            </Border>
        </Grid>
    </Border>
</Window>


