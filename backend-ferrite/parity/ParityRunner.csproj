<Project Sdk="Microsoft.NET.Sdk">

	<!-- Entwickler-Werkzeug: vergleicht Native (C#) und Ferrite (Rust) mit identischen Eingaben
	     und erzeugt Golden-Fixtures aus dem echten C#-Code für die Rust-Tests. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<RootNamespace>ParityRunner</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\VideoConverterUI\VideoConverterUI.csproj" />
	</ItemGroup>
</Project>
